@model ReadManager.Web.Services.ReadingProgressApiClient.MemberDetail
@{
    var m = Model;
    ViewData["Title"] = m.DisplayName;
    string StLabel = m.AccountStatus == "Suspended" ? "Tạm ngừng" : m.AccountStatus == "Restricted" ? "Bị hạn chế bình luận" : "Hoạt động";
}
<link rel="stylesheet" href="~/css/plans.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/community.css" asp-append-version="true" />
<div class="container section">
    <div class="section-head"><h2>Trang quản trị</h2></div>
    <div class="admin-shell">
        <partial name="_AdminNav" />
        <div>
            <p><a asp-action="Index">← Danh sách thành viên</a></p>
            <h3>@m.DisplayName</h3>

            <dl class="mem-info">
                <dt>Email</dt><dd>@m.Email</dd>
                <dt>Vai trò</dt><dd>@(m.Role == "Admin" ? "Quản trị viên" : "Thành viên")</dd>
                <dt>Ngày tham gia</dt><dd>@m.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</dd>
                <dt>Đọc gần nhất</dt><dd>@(m.LastReadAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>
                <dt>Gói đang dùng</dt><dd>@(m.HasActivePlan ? "Đang có gói" + (m.PlanEndsAt is { } end ? " (hết hạn " + end.ToLocalTime().ToString("dd/MM/yyyy") + ")" : "") : "Chưa đăng ký gói")</dd>
                <dt>Đang đọc</dt><dd>@m.ReadingStoryCount truyện</dd>
                <dt>Lượt đọc chương</dt><dd>@m.ChapterReadCount</dd>
                <dt>Đang theo dõi</dt><dd>@m.FollowCount truyện</dd>
                <dt>Đơn đã thanh toán</dt><dd>@m.PaidOrderCount (@m.TotalPaid.ToString("N0") đ)</dd>
                <dt>Bình luận</dt><dd>@m.CommentCount</dd>
                <dt>Trạng thái</dt><dd><b>@StLabel</b></dd>
            </dl>

            @if (m.AccountStatus != "Active")
            {
                <div class="banner banner-warn" style="margin:14px 0">
                    <b>@(m.AccountStatus == "Suspended" ? "Tạm ngừng tài khoản" : "Hạn chế bình luận")</b>
                    @if (m.StatusChangedAt is { } changed) { <text>· từ @changed.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</text> }
                    · đến khi Admin khôi phục<br />
                    Lý do: @m.StatusReason
                </div>
                <form asp-action="Restore" method="post" onsubmit="return confirm('Khôi phục tài khoản này?');">
                    <input type="hidden" name="id" value="@m.UserId" />
                    <button class="btn btn-brass" type="submit">Khôi phục tài khoản</button>
                </form>
            }
            else if (m.Role != "Admin")
            {
                <h4>Hạn chế / tạm ngừng</h4>
                <form asp-action="Restrict" method="post" class="pl-form">
                    <input type="hidden" name="id" value="@m.UserId" />
                    <label>Hình thức
                        <select name="kind">
                            <option value="Restricted">Hạn chế bình luận (vẫn đọc truyện được)</option>
                            <option value="Suspended">Tạm ngừng tài khoản (không đăng nhập được)</option>
                        </select>
                    </label>
                    <label style="flex-basis:100%">Lý do (bắt buộc)<textarea name="reason" rows="2" maxlength="500" required minlength="5"></textarea></label>
                    <button class="btn btn-outline btn-sm" type="submit" onclick="return confirm('Áp dụng hạn chế cho tài khoản này?');">Áp dụng</button>
                </form>
            }
            else { <p class="pl-sub">Không thể hạn chế tài khoản quản trị viên.</p> }
        </div>
    </div>
</div>
