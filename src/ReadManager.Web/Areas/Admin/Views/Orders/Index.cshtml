@model ReadManager.Web.Services.PagedApi<ReadManager.Web.Services.OrderApi>
@{ ViewData["Title"] = "Quản lý đơn hàng"; }
<div class="container section">
    <partial name="_AdminNav" /><h1>Quản lý đơn hàng</h1>
    <a asp-action="Recovery">Giao dịch cần cấp lại quyền</a>
    <p>Đơn đang chờ thanh toán chưa cấp quyền đọc. Giao dịch đã thanh toán cần được cấp quyền trước khi mở khóa nội dung.</p>
    @if (Model.Items.Count == 0) { <p>Chưa có đơn hàng.</p> }
    <table class="data">
        <thead><tr><th>Mã đơn</th><th>Nội dung</th><th>Số tiền</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
        @foreach (var order in Model.Items)
        {
            var status = order.Status switch { "Pending" => "Chờ thanh toán", "Paid" => "Đã thanh toán", "Failed" => "Thất bại", "Expired" => "Hết hạn", "Cancelled" => "Đã hủy", _ => order.Status };
            <tr><td>@order.OrderId</td><td>@order.ItemName</td><td>@order.Amount.ToString("N0") đ</td><td>@status</td>
                <td><a asp-area="" asp-controller="Orders" asp-action="Details" asp-route-id="@order.OrderId">Xem đơn</a></td></tr>
        }
        </tbody>
    </table>
    @if (Model.Page > 1) { <a asp-action="Index" asp-route-status="@ViewBag.Status" asp-route-page="@(Model.Page - 1)">Trang trước</a> }
    @if ((long)Model.Page * Model.PageSize < Model.TotalCount) { <a asp-action="Index" asp-route-status="@ViewBag.Status" asp-route-page="@(Model.Page + 1)">Trang sau</a> }
</div>
