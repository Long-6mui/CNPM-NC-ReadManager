@model ReadManager.Web.ViewModels.RevenueStatsVm
@using ReadManager.Web.Services
@using ReadManager.Web.ViewModels
@{
    ViewData["Title"] = "Thống kê doanh thu";
    ViewBag.Tab = "revenue";
    var retry = Context.Request.Path + Context.Request.QueryString;
    string Money(decimal v) => v.ToString("N0") + "đ";
    string W(decimal v, decimal total) => (total <= 0 ? 0 : Math.Min(100, (double)(v / total * 100))).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}
<link rel="stylesheet" href="~/css/plans.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/statistics.css" asp-append-version="true" />
<div class="container section">
    <div class="section-head"><h2>Trang quản trị</h2></div>
    <div class="admin-shell">
        <partial name="_AdminNav" />
        <div class="st-main">
            <h3>Thống kê</h3>
            <partial name="_Tabs" model="Model.Filter" />
            <partial name="_Filter" model="Model.Filter" />

            @if (!Model.Report.Ok) { <partial name="_StatState" model="Model.Report.Notice(retry)" /> }
            else
            {
                var r = Model.Report.Data!;
                if (r.OrderCount == 0)
                {
                    <partial name="_StatState" model='new StatNotice("empty", "Chưa có giao dịch thanh toán thành công trong khoảng thời gian này.", null)' />
                }
                else
                {
                    <div class="st-kpis">
                        <partial name="_Kpi" model='new KpiVm("Tổng doanh thu", Money(r.Total))' />
                        <partial name="_Kpi" model='new KpiVm("Đơn đã thanh toán", r.OrderCount.ToString("N0"), $"Trung bình {Money(r.AverageOrder)}/đơn")' />
                        <partial name="_Kpi" model='new KpiVm("Doanh thu gói đọc", Money(r.PlanTotal), $"{W(r.PlanTotal, r.Total)}% tổng")' />
                        <partial name="_Kpi" model='new KpiVm("Doanh thu mua truyện", Money(r.StoryTotal), $"{W(r.StoryTotal, r.Total)}% tổng")' />
                    </div>

                    <section class="st-card"><div class="st-card-head"><h4>Doanh thu theo ngày</h4>
                        <a class="btn btn-outline btn-sm" asp-action="ExportRevenue" asp-route-from="@Model.Filter.FromText" asp-route-to="@Model.Filter.ToText">Xuất CSV</a></div>
                        @SvgCharts.Columns("Doanh thu theo ngày (đồng)", r.Days.Select(x => x.Date.ToString("dd/MM")).ToList(), new ChartSeries("Doanh thu", r.Days.Select(x => (double)x.Total).ToList()))
                    </section>

                    <section class="st-card"><h4>Doanh thu theo gói đọc</h4>
                        @if (r.ByPlan.Count == 0) { <partial name="_StatState" model='new StatNotice("empty", "Chưa có đơn mua gói trong khoảng này.", null)' /> }
                        else
                        {
                            <div class="st-scroll"><table class="pl-table"><thead><tr><th>Gói</th><th>Lượt mua</th><th>Doanh thu</th><th>Tỷ trọng</th></tr></thead><tbody>
                            @foreach (var p in r.ByPlan)
                            {
                                <tr><td>@p.Name</td><td>@p.Orders.ToString("N0")</td><td>@Money(p.Revenue)</td><td><span class="st-bar" aria-hidden="true"><i style="width:@W(p.Revenue, r.PlanTotal)%"></i></span>@W(p.Revenue, r.PlanTotal)%</td></tr>
                            }
                            </tbody></table></div>
                        }
                    </section>

                    <section class="st-card"><h4>Doanh thu và lượt mua theo truyện</h4>
                        @if (r.ByStory.Count == 0) { <partial name="_StatState" model='new StatNotice("empty", "Chưa có lượt mua truyện trong khoảng này.", null)' /> }
                        else
                        {
                            <div class="st-scroll"><table class="pl-table"><thead><tr><th>Truyện</th><th>Lượt mua</th><th>Doanh thu</th><th>Tỷ trọng</th></tr></thead><tbody>
                            @foreach (var s in r.ByStory.Take(20))
                            {
                                <tr><td>@s.Name</td><td>@s.Orders.ToString("N0")</td><td>@Money(s.Revenue)</td><td><span class="st-bar" aria-hidden="true"><i style="width:@W(s.Revenue, r.StoryTotal)%"></i></span>@W(s.Revenue, r.StoryTotal)%</td></tr>
                            }
                            </tbody></table></div>
                            @if (r.ByStory.Count > 20) { <p class="st-note">Hiển thị 20/@r.ByStory.Count truyện có doanh thu cao nhất.</p> }
                        }
                    </section>

                    <details class="st-card"><summary>Chi tiết theo từng ngày</summary>
                        <div class="st-scroll"><table class="pl-table"><thead><tr><th>Ngày</th><th>Số đơn</th><th>Gói đọc</th><th>Mua truyện</th><th>Tổng</th></tr></thead><tbody>
                        @foreach (var d in r.Days.Where(x => x.Orders > 0))
                        {
                            <tr><td>@d.Date.ToString("dd/MM/yyyy")</td><td>@d.Orders</td><td>@Money(d.Plan)</td><td>@Money(d.Story)</td><td>@Money(d.Total)</td></tr>
                        }
                        </tbody></table></div>
                    </details>
                }
                @if (r.Truncated) { <div class="banner banner-warn" role="alert">Chỉ đọc được 3.000 đơn gần nhất nên số liệu có thể thiếu. Hãy chọn khoảng thời gian ngắn hơn.</div> }
                <p class="st-note">Chỉ tính đơn đã thanh toán thành công; mỗi mã đơn được tính một lần@(r.DuplicatesIgnored > 0 ? $" (đã bỏ qua {r.DuplicatesIgnored} dòng trùng)" : ""). Ngày tính theo ngày thanh toán, giờ Việt Nam. Số liệu lấy từ danh sách đơn hàng của hệ thống.</p>
            }
        </div>
    </div>
</div>
