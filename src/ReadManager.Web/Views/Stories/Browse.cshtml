@model BrowseVm
@{
    ViewData["Title"] = "Khám phá";
    bool hasFilter = !string.IsNullOrEmpty(Model.Q) || Model.GenreId.HasValue || Model.Access.HasValue || Model.Status.HasValue || Model.Sort != "updated";
}
<div class="container section">
    <div class="section-head">
        <h2>@(string.IsNullOrEmpty(Model.Q) ? "Khám phá thư viện" : $"Kết quả cho “{Model.Q}”")</h2>
        <span class="section-sub">@Model.Total truyện@(Model.PageCount > 1 ? $" · trang {Model.Page}/{Model.PageCount}" : "")</span>
    </div>

    <form method="get" asp-action="Browse" class="filter-row">
        <input type="search" name="q" value="@Model.Q" placeholder="Tên truyện, tác giả…" aria-label="Từ khóa" style="flex:1; min-width:180px;" />
        <select name="genre" class="select" onchange="this.form.submit()" aria-label="Thể loại">
            <option value="">Tất cả thể loại</option>
            @foreach (var g in Model.Genres)
            {
                <option value="@g.Id" selected="@(Model.GenreId == g.Id)">@g.Name</option>
            }
        </select>
        <select name="access" class="select" onchange="this.form.submit()" aria-label="Hình thức">
            <option value="">Mọi hình thức</option>
            <option value="Free" selected="@(Model.Access == AccessPolicy.Free)">Miễn phí</option>
            <option value="Mixed" selected="@(Model.Access == AccessPolicy.Mixed)">Kết hợp</option>
            <option value="Paid" selected="@(Model.Access == AccessPolicy.Paid)">Trả phí</option>
        </select>
        <select name="status" class="select" onchange="this.form.submit()" aria-label="Tình trạng">
            <option value="">Mọi tình trạng</option>
            <option value="Ongoing" selected="@(Model.Status == StoryStatus.Ongoing)">Đang ra</option>
            <option value="Completed" selected="@(Model.Status == StoryStatus.Completed)">Hoàn thành</option>
            <option value="Paused" selected="@(Model.Status == StoryStatus.Paused)">Tạm ngừng</option>
        </select>
        <select name="sort" class="select" onchange="this.form.submit()" aria-label="Sắp xếp">
            <option value="updated" selected="@(Model.Sort == "updated")">Mới cập nhật</option>
            <option value="newest" selected="@(Model.Sort == "newest")">Mới đăng</option>
            <option value="title" selected="@(Model.Sort == "title")">Tên A–Z</option>
        </select>
        <button type="submit" class="btn btn-brass btn-sm">Lọc</button>
        @if (hasFilter)
        {
            <a class="btn btn-ghost btn-sm" asp-action="Browse">Xóa lọc</a>
        }
    </form>

    @if (Model.Stories.Any())
    {
        <div class="grid-cards">
            @foreach (var s in Model.Stories) { <partial name="_StoryCard" model="s" /> }
        </div>
        @if (Model.PageCount > 1)
        {
            int cur = Model.Page, last = Model.PageCount;
            var shown = new SortedSet<int> { 1, last };
            for (int p = cur - 2; p <= cur + 2; p++) { if (p >= 1 && p <= last) shown.Add(p); }
            int prevShown = 0;
            <nav class="pager" aria-label="Phân trang truyện">
                @if (cur > 1) { <a asp-action="Browse" asp-route-q="@Model.Q" asp-route-genre="@Model.GenreId" asp-route-access="@Model.Access" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort" asp-route-page="@(cur - 1)" title="Trang trước">«</a> }
                @foreach (var p in shown)
                {
                    if (p - prevShown > 1) { <span class="dots">…</span> }
                    if (p == cur) { <span class="current">@p</span> }
                    else { <a asp-action="Browse" asp-route-q="@Model.Q" asp-route-genre="@Model.GenreId" asp-route-access="@Model.Access" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort" asp-route-page="@p">@p</a> }
                    prevShown = p;
                }
                @if (cur < last) { <a asp-action="Browse" asp-route-q="@Model.Q" asp-route-genre="@Model.GenreId" asp-route-access="@Model.Access" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort" asp-route-page="@(cur + 1)" title="Trang sau">»</a> }
            </nav>
        }
    }
    else
    {
        <div class="empty-state">
            <h3>Không tìm thấy truyện phù hợp</h3>
            <p>Thử đổi từ khóa hoặc xóa bớt tiêu chí lọc để xem nhiều truyện hơn.</p>
            <a class="btn btn-brass" asp-action="Browse">Xem tất cả truyện</a>
        </div>
    }
</div>
