@model StoryDetailVm
@{
    ViewData["Title"] = Model.Story.Title;
    var story = Model.Story;
    string chipClass = story.Access == AccessPolicy.Free ? "chip-free" : story.Access == AccessPolicy.Paid ? "chip-paid" : "chip-mixed";
    string chipLabel = story.Access == AccessPolicy.Free ? "Miễn phí" : story.Access == AccessPolicy.Paid ? "Trả phí" : "Kết hợp";
    string statusLabel = story.Status == StoryStatus.Ongoing ? "Đang ra" : story.Status == StoryStatus.Completed ? "Hoàn thành" : "Tạm ngừng";
    int? readNo = Model.ContinueChapterNo ?? Model.FirstVisibleChapterNo;
}
<div class="story-hero">
    <div class="container story-hero-inner">
        <div class="story-cover">
            @if (!string.IsNullOrEmpty(story.CoverUrl))
            {
                <img src="@story.CoverUrl" alt="Bìa truyện @story.Title">
            }
            else
            {
                <div class="gen-cover"><span>@story.Title</span></div>
            }
            <span class="chip @chipClass">@chipLabel</span>
        </div>
        <div>
            <div class="tag-row">
                @foreach (var g in Model.GenreNames)
                {
                    <span class="tag">@g</span>
                }
                <span class="tag">@statusLabel</span>
            </div>
            <h1>@story.Title</h1>
            <div class="author">✍️ @(string.IsNullOrEmpty(story.Author) ? "Khuyết danh" : story.Author)</div>
            <p class="desc">@(string.IsNullOrWhiteSpace(story.Description) ? "Chưa có giới thiệu chi tiết cho truyện này." : story.Description)</p>
            <div class="actions">
                @if (readNo.HasValue)
                {
                    <a class="btn btn-brass" asp-action="Read" asp-route-storyId="@story.Id" asp-route-no="@readNo">
                        @(Model.ContinueChapterNo.HasValue ? $"📖 Đọc tiếp — Chương {Model.ContinueChapterNo}" : "📖 Đọc từ đầu")
                    </a>
                }
                else
                {
                    <span class="btn" style="background:rgba(255,255,255,.12); color:#fff; border:1px solid rgba(255,255,255,.35); cursor:not-allowed;">📖 Chưa có chương</span>
                }

                @if (Model.Owned)
                {
                    <span class="btn btn-outline" style="cursor:default;">✔ Đã sở hữu trọn bộ</span>
                }
                else if (Model.PendingOrderId.HasValue)
                {
                    <a class="btn btn-outline" asp-controller="Orders" asp-action="Details" asp-route-id="@Model.PendingOrderId">⏳ Đơn đang chờ thanh toán</a>
                }
                else if (Model.CanBuy)
                {
                    <a class="btn btn-brass" asp-controller="Orders" asp-action="Checkout" asp-route-storyId="@story.Id">🛒 Mua trọn bộ — @Model.BuyPrice.ToString("N0")₫</a>
                }

                <button type="button" class="btn btn-outline fav-btn" data-id="@story.Id" data-title="@story.Title" data-author="@story.Author" data-cover="@story.CoverUrl"><i>♡</i> <span>Yêu thích</span></button>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-action="Follow" asp-route-id="@story.Id" method="post" style="display:inline;">
                        <input type="hidden" name="follow" value="@(Model.IsFollowing ? "false" : "true")" />
                        <button type="submit" class="btn btn-outline" title="@Model.FollowerCount người đang theo dõi">
                            @(Model.IsFollowing ? "🔔 Đang theo dõi" : "🔕 Theo dõi") (@Model.FollowerCount)
                        </button>
                    </form>
                }
                else
                {
                    <a class="btn btn-outline" asp-controller="Account" asp-action="Login"
                       asp-route-returnUrl="@Url.Action("Details", new { id = story.Id })">🔕 Theo dõi (@Model.FollowerCount)</a>
                }
            </div>
            <div class="stat-row">
                <div><b>@Model.TotalChapters</b><span>Chương</span></div>
                <div><b>@(story.FreeChapterCount >= 999 ? "Tất cả" : story.FreeChapterCount.ToString())</b><span>Chương miễn phí</span></div>
                <div><b>@Model.FollowerCount</b><span>Người theo dõi</span></div>
            </div>
        </div>
    </div>
</div>

<style>
    .chapter-box {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 24px;
        box-shadow: var(--shadow-sm);
    }

        .chapter-box h2 {
            text-align: center;
            font-size: 18px;
            letter-spacing: .04em;
            text-transform: uppercase;
            color: var(--brass);
            margin-bottom: 18px;
        }

    .chapter-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: 22px;
    }

    @@media (max-width: 700px) {
        .chapter-grid {
            grid-template-columns: 1fr;
        }
    }

    .chapter-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 11px 12px;
        border-radius: 8px;
        font-size: 14px;
        color: var(--text);
        border-bottom: 1px dashed var(--border);
        transition: background .15s, color .15s;
    }

        .chapter-item:hover {
            background: var(--brass);
            color: #fff;
        }

            .chapter-item:hover .muted, .chapter-item:hover b {
                color: #fff;
            }

        .chapter-item .arrow {
            flex: none;
            opacity: .65;
        }

        .chapter-item .name {
            flex: 1;
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .chapter-item .muted {
            color: var(--muted);
        }

    .upcoming-tag {
        flex: none;
        font-size: 11.5px;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 99px;
        background: rgba(245, 182, 62, .2);
        color: #b4690e;
        white-space: nowrap;
    }

    :root[data-theme="dark"] .upcoming-tag {
        color: var(--amber);
    }

    .chapter-item:hover .upcoming-tag {
        background: rgba(255, 255, 255, .24);
        color: #fff;
    }
</style>

<div class="container section">
    <div class="two-col">
        <div>
            <div class="chapter-box" id="chapters">
                <h2>Danh sách chương (@Model.TotalChapters)</h2>
                @if (Model.Chapters.Any())
                {
                    <div class="chapter-grid">
                        @foreach (var c in Model.Chapters)
                        {
                            bool noTitle = string.IsNullOrWhiteSpace(c.Title) || c.Title.Trim() == $"Chương {c.No}";
                            <a class="chapter-item" asp-action="Read" asp-route-storyId="@story.Id" asp-route-no="@c.No"
                               title="@(noTitle ? $"Chương {c.No}" : $"Chương {c.No}: {c.Title}")">
                                <span class="arrow">»</span>
                                <span class="name">
                                    <b>@(noTitle ? $"Chương {c.No}" : $"Chương {c.No}:")</b>
                                    @if (!noTitle)
                                    {
                                        <span>@c.Title</span>
                                    }
                                </span>
                                @if (c.UpcomingAt.HasValue)
                                {
                                    <span class="upcoming-tag" title="Sắp ra mắt">⏳ @c.UpcomingAt.Value.ToString("HH:mm dd/MM")</span>
                                }
                                else if (c.Locked)
                                {
                                    <span title="Chương trả phí — cần mở khóa">🔒</span>
                                }
                            </a>
                        }
                    </div>

                    @if (Model.ChapterPageCount > 1)
                    {
                        int cur = Model.ChapterPage, last = Model.ChapterPageCount;
                        var shown = new SortedSet<int> { 1, last };
                        for (int p = cur - 2; p <= cur + 2; p++) { if (p >= 1 && p <= last) shown.Add(p); }
                        int prevShown = 0;
                        <nav class="pager" aria-label="Phân trang chương">
                            @if (cur > 1)
                            {
                                <a asp-action="Details" asp-route-id="@story.Id" asp-route-page="@(cur - 1)" asp-fragment="chapters" title="Trang trước">«</a>
                            }
                            @foreach (var p in shown)
                            {
                                if (p - prevShown > 1)
                                {
                                    <span class="dots">…</span>
                                }
                                if (p == cur)
                                {
                                    <span class="current">@p</span>
                                }
                                else
                                {
                                    <a asp-action="Details" asp-route-id="@story.Id" asp-route-page="@p" asp-fragment="chapters">@p</a>
                                }
                                prevShown = p;
                            }
                            @if (cur < last)
                            {
                                <a asp-action="Details" asp-route-id="@story.Id" asp-route-page="@(cur + 1)" asp-fragment="chapters" title="Trang sau">»</a>
                            }
                        </nav>
                    }
                }
                else
                {
                    <div class="empty-state" style="border:none; padding:32px 12px;">
                        <h3>Chưa có chương nào</h3>
                        <p style="margin-bottom:0;">Quản trị viên sẽ sớm đăng nội dung đầu tiên.</p>
                    </div>
                }
            </div>
        </div>
        <div>
            <div class="panel">
                <h3 style="font-size:16px; margin-bottom:10px;">Thông tin truyện</h3>
                <p style="font-size:13.5px; color:var(--muted);">@(string.IsNullOrWhiteSpace(story.Description) ? "Chưa có giới thiệu chi tiết cho truyện này." : story.Description)</p>
                <div class="divider"></div>
                <div style="font-size:13.5px; display:flex; flex-direction:column; gap:8px;">
                    <div class="flexbar"><span style="color:var(--muted)">Tác giả</span><b>@(string.IsNullOrWhiteSpace(story.Author) ? "Khuyết danh" : story.Author)</b></div>
                    <div class="flexbar"><span style="color:var(--muted)">Tình trạng</span><b>@statusLabel</b></div>
                    <div class="flexbar"><span style="color:var(--muted)">Hình thức</span><b>@chipLabel</b></div>
                    <div class="flexbar"><span style="color:var(--muted)">Cập nhật</span><b>@story.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy")</b></div>
                </div>
            </div>
        </div>
    </div>
</div>
