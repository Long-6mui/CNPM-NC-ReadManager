@model ReadVm
@{
    ViewData["Title"] = $"Chương {Model.Chapter.No}: {Model.Chapter.Title}";
    var paragraphs = (Model.Chapter.Content ?? "").Replace("\r\n", "\n").Split("\n\n", StringSplitOptions.RemoveEmptyEntries);

    // ===== CHỐNG LỘ NỘI DUNG: hình mờ (watermark) ghi tên người đọc + thời gian =====
    // Ai chụp màn hình đem đi chia sẻ thì ảnh vẫn dính tên tài khoản → truy ra người làm lộ.
    var reader = User.Identity?.IsAuthenticated == true ? User.Identity!.Name ?? "Độc giả" : "Khách";
    var markText = System.Security.SecurityElement.Escape($"{reader} · {DateTime.Now:dd/MM/yyyy HH:mm}");
    var markSvg = $"<svg xmlns='http://www.w3.org/2000/svg' width='360' height='200'>"
                + $"<text x='20' y='120' transform='rotate(-25 180 100)' font-family='Arial' font-size='15' fill='rgba(120,120,120,0.16)'>{markText}</text></svg>";
    var markUrl = "data:image/svg+xml;charset=utf-8," + Uri.EscapeDataString(markSvg);
}
<style>
    /* ===== Chống copy / chụp / in nội dung chương ===== */
    .protected {
        position: relative;
        user-select: none;
        -webkit-user-select: none;
        -webkit-touch-callout: none;
    }

        .protected .watermark {
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 2;
            background-repeat: repeat;
        }

        .protected.shielded .reader-text {
            filter: blur(10px);
            transition: filter .15s;
        }
    /* mất focus / bấm PrtSc → làm mờ */
    .shield-msg {
        display: none;
        position: sticky;
        top: 40%;
        z-index: 3;
        text-align: center;
        font-weight: 600;
    }

    .protected.shielded .shield-msg {
        display: block;
    }

    @@media print {
        .protected .reader-text {
            display: none !important;
        }
        /* in trang → không in nội dung */
        .protected::after {
            content: "Nội dung chương được bảo vệ, không thể in.";
        }
    }
</style>
<div class="reader-bar">
    <div class="container reader-bar-inner">
        <a class="btn btn-ghost btn-sm" asp-action="Details" asp-route-id="@Model.Story.Id">← @Model.Story.Title</a>
        <span class="rb-title">Chương @Model.Chapter.No: @Model.Chapter.Title</span>
        <div style="display:flex; gap:6px;">
            <button class="size-btn" id="fontSmaller" type="button">A-</button>
            <button class="size-btn" id="fontBigger" type="button">A+</button>
        </div>
    </div>
</div>
<div class="reader-wrap">
    @if (Model.UpcomingAt.HasValue && !string.IsNullOrEmpty(Model.Chapter.Content))
    {
        <div class="banner banner-warn" style="margin-bottom:18px;">Bạn đang xem trước — chương hẹn ra mắt lúc @Model.UpcomingAt.Value.ToString("HH:mm dd/MM/yyyy"), độc giả chưa đọc được.</div>
    }
    @if (Model.NotYetPublicPreview)
    {
        <div class="banner banner-warn" style="margin-bottom:18px;">Bạn đang xem trước với quyền quản trị — độc giả thường chưa thấy chương này.</div>
    }
    <h1>Chương @Model.Chapter.No: @Model.Chapter.Title</h1>

    @if (Model.UpcomingAt.HasValue && !Model.NotYetPublicPreview && string.IsNullOrEmpty(Model.Chapter.Content))
    {
        @* Chương hẹn giờ: chưa tới giờ ra mắt → hiện giờ ra mắt + đếm ngược, tới giờ tự tải lại trang *@
        var releaseIso = DateTime.SpecifyKind(Model.UpcomingAt.Value, DateTimeKind.Local).ToUniversalTime().ToString("o");
        <div class="locked-box">
            <h3>⏳ Chương sắp ra mắt</h3>
            <p>Chương này sẽ ra mắt lúc <b>@Model.UpcomingAt.Value.ToString("HH:mm 'ngày' dd/MM/yyyy")</b>.</p>
            <p style="font-size:20px; font-weight:700; margin-top:8px;" id="countdown" data-release="@releaseIso"></p>
        </div>
        <script>
            (function () {
                const el = document.getElementById('countdown');
                const release = new Date(el.dataset.release).getTime();
                const pad = n => String(n).padStart(2, '0');
                function tick() {
                    let s = Math.max(0, Math.floor((release - Date.now()) / 1000));
                    if (s === 0) { location.reload(); return; }   // tới giờ → tải lại để đọc
                    const d = Math.floor(s / 86400); s %= 86400;
                    const h = Math.floor(s / 3600); s %= 3600;
                    const m = Math.floor(s / 60); s %= 60;
                    el.textContent = 'Còn ' + (d ? d + ' ngày ' : '') + pad(h) + ':' + pad(m) + ':' + pad(s);
                    setTimeout(tick, 1000);
                }
                tick();
            })();
        </script>
    }
    else if (Model.Locked)
    {
        <div class="locked-box">
            <h3>Chương này dành cho độc giả đã mở khóa</h3>
            <p>Nội dung chương này đang khóa. Bạn có thể xem các lựa chọn mua truyện hoặc gói đọc.</p>
            <div style="display:flex; gap:10px; justify-content:center; flex-wrap:wrap; margin-top:12px;">
                <a class="btn btn-brass" asp-controller="Orders" asp-action="Checkout" asp-route-storyId="@Model.Story.Id">Mua trọn bộ truyện</a>
                <a class="btn btn-outline" asp-controller="Plans" asp-action="Index">Xem gói đọc</a>
            </div>
        </div>
    }
    else
    {
        <div class="reader-content protected" id="readerContent">
            <div class="watermark" style="background-image:url(&quot;@markUrl&quot;)"></div>
            <div class="shield-msg">🔒 Nội dung được bảo vệ — quay lại trang để tiếp tục đọc</div>
            <div class="reader-text">
                @foreach (var p in paragraphs)
                {
                    <p>@Html.Raw(string.Join("<br>", p.Split('\n').Select(line => Html.Encode(line.Normalize()))))</p>
                }
            </div>
        </div>
        <script>
            // ===== Chống copy / chụp màn hình nội dung chương =====
            (function () {
                const box = document.getElementById('readerContent');
                const stop = e => e.preventDefault();

                // 1. Chặn bôi đen, chuột phải, copy, cắt, kéo thả chữ
                ['copy', 'cut', 'contextmenu', 'selectstart', 'dragstart'].forEach(ev => box.addEventListener(ev, stop));
                // (bỏ qua ô nhập bình luận / báo cáo để người đọc vẫn copy/dán chữ của mình được)
                const isTyping = e => e.target.closest && e.target.closest('textarea, input, select');
                document.addEventListener('copy', e => { if (isTyping(e)) return; e.preventDefault(); e.clipboardData && e.clipboardData.setData('text/plain', ''); });

                // 2. Chặn phím tắt: Ctrl+C / A / X / S / P / U (copy, chọn hết, lưu trang, in, xem mã nguồn)
                document.addEventListener('keydown', e => {
                    if (isTyping(e)) return;   // đang gõ bình luận → không chặn phím tắt
                    const k = e.key.toLowerCase();
                    if ((e.ctrlKey || e.metaKey) && ['c', 'a', 'x', 's', 'p', 'u'].includes(k)) { e.preventDefault(); }
                });

                // 3. Bấm PrintScreen → xóa ảnh vừa chụp khỏi clipboard + làm mờ nội dung một lúc
                const shield = ms => {
                    box.classList.add('shielded');
                    if (ms) setTimeout(() => box.classList.remove('shielded'), ms);
                };
                document.addEventListener('keyup', e => {
                    if (e.key === 'PrintScreen') {
                        try { navigator.clipboard.writeText(''); } catch { }
                        shield(2000);
                    }
                });

                // 4. Rời khỏi trang (mở công cụ cắt màn hình Win+Shift+S, chuyển cửa sổ, chuyển tab) → làm mờ
                window.addEventListener('blur', () => shield());
                window.addEventListener('focus', () => box.classList.remove('shielded'));
                document.addEventListener('visibilitychange', () => document.hidden ? shield() : box.classList.remove('shielded'));
            })();
        </script>
    }

    <div class="reader-toolbar">
        @if (Model.PrevNo.HasValue)
        {
            <a class="btn btn-outline btn-sm" asp-action="Read" asp-route-storyId="@Model.Story.Id" asp-route-no="@Model.PrevNo">← Chương trước</a>
        }
        else
        {

            <span></span>
        }
        <a class="btn btn-outline btn-sm" asp-action="Details" asp-route-id="@Model.Story.Id">Danh sách chương</a>
        @if (Model.NextNo.HasValue)
        {
            <a class="btn btn-outline btn-sm" asp-action="Read" asp-route-storyId="@Model.Story.Id" asp-route-no="@Model.NextNo">Chương sau →</a>
        }
        else
        {

            <span></span>
        }
    </div>

    @* ===== PB33 — NÚT BÁO CÁO VI PHẠM (dùng chung cho chương và bình luận) ===== *@
    @{
        var loggedIn = User.Identity?.IsAuthenticated == true;
        var chapterReadable = !Model.UpcomingAt.HasValue || Model.NotYetPublicPreview || !string.IsNullOrEmpty(Model.Chapter.Content);

        async Task ReportBox(string targetType, int targetId, string label)
        {
            <details class="report-dd">
                <summary>⚑ @label</summary>
                <form asp-action="Report" method="post" class="report-form">
                    <input type="hidden" name="targetType" value="@targetType" />
                    <input type="hidden" name="targetId" value="@targetId" />
                    <input type="hidden" name="storyId" value="@Model.Story.Id" />
                    <input type="hidden" name="no" value="@Model.Chapter.No" />
                    <div class="field">
                        <label>Lý do</label>
                        <select name="reason" required>
                            <option value="">— Chọn lý do —</option>
                            @foreach (var r in Model.ReportReasons)
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>Ghi chú thêm (bắt buộc nếu chọn "Khác")</label>
                        <textarea name="note" maxlength="500" rows="2"></textarea>
                    </div>
                    <button type="submit" class="btn btn-danger btn-sm">Gửi báo cáo</button>
                </form>
            </details>
        }
    }

    @if (chapterReadable && loggedIn && !Model.NotYetPublicPreview)
    {
        <div class="report-chapter">@{ await ReportBox("Chapter", Model.Chapter.Id, "Báo cáo chương này"); }</div>
    }

    @* ===== PB32 — BÌNH LUẬN ===== *@
    @if (chapterReadable)
    {
        <section class="comments" id="comments">
            <h3>Bình luận (@Model.CommentTotal)</h3>

            @if (loggedIn && Model.RestrictionNote is not null)
            {
                <div class="banner banner-warn" role="alert" style="margin-bottom:16px">@Model.RestrictionNote</div>
            }
            else if (loggedIn)
            {
                <form asp-action="PostComment" method="post" class="comment-form">
                    <input type="hidden" name="storyId" value="@Model.Story.Id" />
                    <input type="hidden" name="no" value="@Model.Chapter.No" />
                    <input type="hidden" name="chapterId" value="@Model.Chapter.Id" />
                    <div class="field">
                        <textarea name="content" maxlength="1000" required placeholder="Chia sẻ cảm nghĩ của bạn về chương này..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-brass btn-sm">Gửi bình luận</button>
                </form>
            }
            else
            {
                <p class="comment-login">
                    <a asp-controller="Account" asp-action="Login"
                       asp-route-returnUrl="@Url.Action("Read", new { storyId = Model.Story.Id, no = Model.Chapter.No })">Đăng nhập</a>
                    để bình luận.
                </p>
            }

            @if (Model.Comments.Count == 0)
            {
                <p class="comment-empty">Chưa có bình luận nào. Hãy là người đầu tiên!</p>
            }
            else
            {
                <ul class="comment-list">
                    @foreach (var cm in Model.Comments)
                    {
                        <li class="comment-item">
                            <div class="comment-head">
                                <b>@cm.DisplayName</b>
                                <span class="comment-time">@ReadManager.Web.Services.StoriesApiClient.ToLocal(cm.CreatedAt)?.ToString("HH:mm dd/MM/yyyy")</span>
                                <div class="comment-actions">
                                    @if (cm.CanDelete)
                                    {
                                        <form asp-action="DeleteComment" method="post" onsubmit="return confirm('Xóa bình luận này?');">
                                            <input type="hidden" name="commentId" value="@cm.CommentId" />
                                            <input type="hidden" name="storyId" value="@Model.Story.Id" />
                                            <input type="hidden" name="no" value="@Model.Chapter.No" />
                                            <button type="submit" class="btn btn-ghost btn-sm">Xóa</button>
                                        </form>
                                    }
                                    else if (loggedIn)
                                    {
                                        await ReportBox("Comment", cm.CommentId, "Báo cáo");
                                    }
                                </div>
                            </div>
                            @* white-space: pre-line → giữ xuống dòng; Razor tự mã hóa HTML nên không sợ chèn mã độc *@
                            <div class="comment-body">@cm.Content</div>
                        </li>
                    }
                </ul>
            }
        </section>
    }
    <style>
        .comments { margin-top: 32px; padding-top: 20px; border-top: 1px solid rgba(127,127,127,.25); }
        .comments h3 { margin-bottom: 12px; }
        .comment-form { margin-bottom: 18px; }
        .comment-list { list-style: none; padding: 0; margin: 0; }
        .comment-item { padding: 12px 0; border-bottom: 1px solid rgba(127,127,127,.15); }
        .comment-head { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 4px; }
        .comment-time { font-size: 12.5px; opacity: .65; padding-top: 2px; }
        .comment-actions { margin-left: auto; }
        .comment-body { white-space: pre-line; line-height: 1.55; overflow-wrap: anywhere; }
        .comment-empty, .comment-login { opacity: .75; }

        /* Nút báo cáo: bấm vào mới mở form nhỏ */
        .report-chapter { margin-top: 14px; text-align: right; }
        .report-dd { position: relative; display: inline-block; text-align: left; }
        .report-dd > summary { cursor: pointer; list-style: none; font-size: 12.5px; opacity: .7; padding: 4px 6px; }
        .report-dd > summary::-webkit-details-marker { display: none; }
        .report-dd > summary:hover { opacity: 1; color: var(--crimson); }
        .report-dd[open] > summary { opacity: 1; color: var(--crimson); }
        .report-form { position: absolute; right: 0; z-index: 20; width: 300px; margin-top: 4px; padding: 14px;
                       background: var(--surface); border: 1px solid var(--border); border-radius: 6px; box-shadow: 0 8px 24px rgba(0,0,0,.15); }
        .report-form select, .report-form textarea { width: 100%; }
    </style>
</div>
