@model LoginVm
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="auth-wrap">
    <div class="panel" style="padding:28px;">
        <h2 style="font-size:23px; margin-bottom:6px;">Đăng nhập</h2>
        <p style="font-size:13.5px; color:var(--muted); margin-bottom:20px;">Chào mừng bạn quay lại thư viện <b>FOLIO</b>.</p>
        @if(TempData["RegistrationSuccess"] is string successMsg){
            <div class="banner banner-success" style="margin-bottom:18px;">
                ✓ @successMsg
            </div>
        }
        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
            <div class="field">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" type="email" autocomplete="email" placeholder="nhapemail@example.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Password">Mật khẩu</label>
                <div class="pw-wrap">
                    <input asp-for="Password" type="password" autocomplete="current-password" placeholder="••••••••" />
                    <button type="button" class="pw-eye" aria-label="Hiện mật khẩu">👁</button>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <label class="checkline" style="margin-bottom:18px;">
                <input asp-for="RememberMe" type="checkbox" style="width:auto;" /> Ghi nhớ đăng nhập
            </label>
            <button type="submit" class="btn btn-brass btn-block">Đăng nhập</button>
        </form>
        <p style="font-size:13px; color:var(--muted); margin-top:18px; text-align:center;">
            Chưa có tài khoản? <a asp-action="Register" style="color:var(--brass-2); font-weight:600;">Đăng ký ngay</a>
        </p>
    </div>
</div>
