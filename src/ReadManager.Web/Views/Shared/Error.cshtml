@model ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}
<div class="container section" style="max-width:560px;">
    <div class="empty-state">
        <div style="font-size:36px; margin-bottom:10px;">⚠️</div>
        <h2>Đã xảy ra lỗi khi xử lý yêu cầu</h2>
        <p>Hệ thống gặp sự cố tạm thời. Vui lòng thử tải lại trang hoặc quay về trang chủ.</p>
        @if (Model.ShowRequestId)
        {
            <p class="hint" style="margin-bottom:18px;">Mã yêu cầu: <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-brass" asp-controller="Home" asp-action="Index">← Về trang chủ</a>
    </div>
</div>
