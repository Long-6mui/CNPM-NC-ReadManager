@inject ReadManager.Web.Services.StoriesApiClient Api
@{
    List<ReadManager.Web.Services.GenreDto> navGenres = [];

    try { navGenres = await Api.GenresAsync(); } catch { }



    var unreadNoti = 0;

    if (User.Identity?.IsAuthenticated == true)

    {

        unreadNoti = await Api.UnreadCountAsync(await Microsoft.AspNetCore.Authentication.AuthenticationHttpContextExtensions.GetTokenAsync(Context, "access_token"));

    }



    var area = ViewContext.RouteData.Values["area"]?.ToString() ?? "";

    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="uid" content="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — FOLIO</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&family=Lora:wght@500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/marvel-3d-theme.css" asp-append-version="true" />

    <style>
        .noti-bell {
            position: relative;
            width: 36px;
            height: 36px;
            padding: 0;
            border-radius: 8px;
        }

        .noti-badge {
            position: absolute;
            top: -3px;
            right: -4px;
            min-width: 18px;
            height: 18px;
            padding: 0 5px;
            border-radius: 9px;
            background: var(--marvel-red, #e62429);
            color: #fff;
            font-size: 10.5px;
            font-weight: 700;
            line-height: 18px;
            text-align: center;
            box-shadow: 0 0 10px rgba(230, 36, 41, 0.65);
        }
    </style>
</head>
<body class="marvel-3d-body">
    <div id="scrollProgressBar" class="scroll-progress-bar"></div>
    <a class="skip-link" href="#main-content">Đến nội dung chính</a>

    <header class="topbar marvel-topbar">
        <div class="topbar-inner">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="brand">
                <span class="brand-mark">F</span>
                <span>FOLIO</span>
            </a>

            <nav class="nav-main" aria-label="Điều hướng chính">
                <a class="nav-link @(area == "" && ctrl == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                <a class="nav-link @(area == "" && ctrl == "Stories" ? "active" : "")" asp-area="" asp-controller="Stories" asp-action="Browse">Khám phá</a>
                <a class="nav-link @(area == "" && ctrl == "Plans" ? "active" : "")" asp-area="" asp-controller="Plans" asp-action="Index">Gói đọc</a>
                <details class="dd">
                    <summary>Thể loại ▾</summary>
                    <div class="dd-menu">
                        @foreach (var g in navGenres)

                        {
                            <a asp-area="" asp-controller="Stories" asp-action="Browse" asp-route-genre="@g.GenreId">@g.Name</a>
                        }
                        @if (navGenres.Count == 0)

                        {
                            <span class="hint">Chưa có thể loại</span>
                        }
                    </div>
                </details>
                @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))

                {
                    <a class="nav-link @(area == "Admin" ? "active" : "")" asp-area="Admin" asp-controller="Stories" asp-action="Index">Quản trị</a>
                }
            </nav>

            <form class="nav-search" asp-area="" asp-controller="Stories" asp-action="Browse" method="get">
                <input type="search" name="q" aria-label="Tìm truyện hoặc tác giả" placeholder="Tìm truyện, tác giả…" value="@Context.Request.Query["q"]" />
                <button class="btn btn-brass btn-sm" type="submit">Tìm</button>
            </form>

            <div class="nav-right">
                <button type="button" class="btn btn-ghost" id="themeToggle" aria-label="Đổi giao diện sáng/tối" title="Đổi giao diện sáng / tối">◐</button>
                @if (User.Identity?.IsAuthenticated == true)

                {
                    <a class="btn btn-ghost noti-bell" asp-area="" asp-controller="Notifications" asp-action="Index" aria-label="Thông báo" title="Thông báo">
                        🔔@if (unreadNoti > 0)

                        {
                            <span class="noti-badge">@(unreadNoti > 99 ? "99+" : unreadNoti.ToString())</span>
                        }
                    </a>
                    <details class="dd user-dd">
                        <summary class="avatar" aria-label="Tài khoản">@(string.IsNullOrWhiteSpace(User.Identity?.Name) ? "?" : User.Identity!.Name!.Trim()[0].ToString().ToUpper())</summary>
                        <div class="user-menu">
                            <div class="user-menu-name">@User.Identity.Name</div>
                            <a asp-area="" asp-controller="Account" asp-action="Profile">Tài khoản của tôi</a>
                            <a asp-area="" asp-controller="Library" asp-action="Index">Thư viện của tôi</a>
                            <a asp-area="" asp-controller="Plans" asp-action="Mine">Gói &amp; thanh toán của tôi</a>
                            <a asp-area="" asp-controller="Notifications" asp-action="Index">Thông báo @(unreadNoti > 0 ? $"({unreadNoti})" : "")</a>
                            @if (User.IsInRole("Admin"))

                            {
                                <a asp-area="Admin" asp-controller="Stories" asp-action="Index">Trang quản trị</a>
                            }
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post"><button type="submit">Đăng xuất</button></form>
                        </div>
                    </details>
                }

                else

                {
                    <a class="btn btn-brass btn-sm" asp-area="" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                }
            </div>
        </div>
    </header>

    @if (TempData["Toast"] is string message)

    {
        <div class="toast-float" id="globalToast" role="status">
            <span>@message</span>
            <button type="button" class="toast-close" aria-label="Đóng thông báo">&times;</button>
        </div>
    }

    <main id="main-content">@RenderBody()</main>

    <footer class="marvel-footer">
        <div class="container">
            <div class="ft">
                <div>
                    <h4>Thông tin liên hệ</h4>
                    <span class="ft-brand"><i>F</i>FOLIO</span>
                    <p>Email: nhom0503@example.com</p>
                    <div class="ft-social" aria-label="Kênh cộng đồng">
                        <span title="Facebook">f</span>
                        <span title="YouTube">▶</span>
                        <span title="Zalo">Z</span>
                    </div>
                </div>
                <div>
                    <h4>Giới thiệu</h4>
                    <p><strong>Chào mừng bạn đến với FOLIO.</strong> Thư viện đọc truyện trực tuyến, nơi mỗi trang sách mở ra một chân trời mới.</p>
                    <p>Chúng tôi giới thiệu nhiều thể loại: từ ngôn tình, đời sống đến phiêu lưu kỳ ảo, để mỗi độc giả đều tìm được câu chuyện dành cho mình.</p>
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">Chính sách bảo mật và quyền riêng tư</a>
                </div>
                <div>
                    <h4>Khám phá</h4>
                    <a asp-area="" asp-controller="Stories" asp-action="Browse">Tất cả truyện</a>
                    <a asp-area="" asp-controller="Stories" asp-action="Browse" asp-route-access="Free">Đọc miễn phí</a>
                    <a asp-area="" asp-controller="Stories" asp-action="Browse" asp-route-status="Completed">Truyện hoàn thành</a>
                    <a asp-area="" asp-controller="Plans" asp-action="Index">Gói đọc hội viên</a>
                    @if (User.Identity?.IsAuthenticated == true)

                    {
                        <a asp-area="" asp-controller="Library" asp-action="Index">Thư viện của tôi</a>
                        <a asp-area="" asp-controller="Account" asp-action="Profile">Tài khoản của tôi</a>
                    }

                    else

                    {
                        <a asp-area="" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                        <a asp-area="" asp-controller="Account" asp-action="Register">Đăng ký</a>
                    }
                </div>
            </div>
            <div class="ft-note">
                <span>© 2026 FOLIO — Đồ án nhóm 05-03.</span>
                <span>Đọc truyện mọi lúc, mọi nơi.</span>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/user-extras.js" asp-append-version="true"></script>
    <script src="~/js/marvel-3d-engine.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>