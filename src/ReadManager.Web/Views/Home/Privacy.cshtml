@{
    ViewData["Title"] = "Chính sách bảo mật";
}
<div class="container section" style="max-width:780px;">
    <div class="section-head">
        <h2>Chính sách bảo mật và quyền riêng tư</h2>
    </div>
    <div class="panel" style="line-height:1.75;">
        <h3 style="font-size:17px; margin-bottom:8px;">1. Thông tin chúng tôi thu thập</h3>
        <p style="color:var(--muted);">Khi đăng ký và sử dụng thư viện <b>FOLIO</b>, hệ thống lưu trữ tên hiển thị, địa chỉ email, lịch sử đọc chương, danh sách truyện theo dõi và thông tin giao dịch gói đọc / mua truyện của bạn.</p>

        <div class="divider"></div>
        <h3 style="font-size:17px; margin-bottom:8px;">2. Mục đích sử dụng dữ liệu</h3>
        <p style="color:var(--muted);">Dữ liệu được sử dụng để đồng bộ tiến độ đọc giữa các phiên truy cập, gửi thông báo khi truyện bạn theo dõi cập nhật chương mới và xác thực quyền truy cập các chương trả phí.</p>

        <div class="divider"></div>
        <h3 style="font-size:17px; margin-bottom:8px;">3. Bảo vệ nội dung &amp; tài khoản</h3>
        <p style="color:var(--muted); margin-bottom:0;">Chúng tôi không chia sẻ thông tin cá nhân của độc giả cho bên thứ ba. Mọi nội dung truyện trên hệ thống đều được bảo vệ bản quyền; vui lòng không sao chép hoặc phát tán trái phép.</p>
    </div>
</div>
