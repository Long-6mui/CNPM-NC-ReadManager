@model CheckoutVm
@using ReadManager.Web.Services
@{
    ViewData["Title"] = "Mua trọn bộ — " + Model.Story.Title;
    var story = Model.Story;
}
<div class="container section" style="max-width:780px;">
    <div class="section-head">
        <h2>🛒 Mua trọn bộ truyện</h2>
        <span class="section-sub">Thanh toán một lần, mở khóa vĩnh viễn</span>
    </div>

    <div class="panel checkout">
        <div class="checkout-cover">
            @if (!string.IsNullOrEmpty(story.CoverUrl))
            {
                <img src="@story.CoverUrl" alt="Bìa truyện @story.Title" />
            }
            else
            {
                <div class="gen-cover"><span>@story.Title</span></div>
            }
        </div>
        <div class="checkout-info">
            <h3>@story.Title</h3>
            <div class="hint" style="font-size:13.5px;">@(string.IsNullOrEmpty(story.Author) ? "Khuyết danh" : story.Author) · @Model.TotalChapters chương đã ra</div>

            @if (!Model.HasDiscount) { <div class="checkout-price">@Model.Quote.Amount.ToString("N0")₫</div> }

            <ul class="checkout-benefits">
                <li>✔ Đọc <b>vĩnh viễn</b> tất cả chương của truyện, kể cả các chương ra sau này</li>
                <li>✔ Chỉ trả tiền <b>một lần</b> — khác gói đọc theo tháng, không giới hạn thời gian sử dụng</li>
                <li>✔ Quyền đọc gắn trực tiếp với tài khoản, sử dụng được trên cả Web và Mobile</li>
            </ul>

            @if (Model.Quote.PendingOrderId.HasValue)
            {
                <div class="banner banner-info" style="margin-bottom:16px;">
                    Bạn đang có một đơn hàng chờ thanh toán cho truyện này — bấm <b>“Thanh toán”</b> để tiếp tục đơn đó.
                    Voucher (nếu có) đã được giữ cho đơn này.
                </div>
            }
            else if (!Model.VouchersUnavailable)
            {
                @if (Model.VoucherError is string voucherError) { <div class="banner banner-warn" role="alert" style="margin-bottom:12px;">@voucherError</div> }
                <form method="get" asp-action="Checkout" class="vc-box">
                    <input type="hidden" name="storyId" value="@story.Id" />
                    <h4>🎟 Voucher giảm giá</h4>
                    @if (Model.Vouchers.Count == 0)
                    {
                        <p class="hint" style="margin:0;">Bạn chưa có voucher nào dùng được. <a asp-controller="Account" asp-action="Rewards" asp-fragment="vouchers">Đổi xu lấy voucher →</a></p>
                    }
                    else
                    {
                        <div class="vc-list">
                            <label class="vc-opt">
                                <input type="radio" name="voucherId" value="" @(Model.SelectedVoucherId is null ? "checked" : "") onchange="this.form.submit()" />
                                <span><b>Không dùng voucher</b></span>
                            </label>
                            @foreach (var v in Model.Vouchers)
                            {
                                var tooSmall = v.MinOrderAmount is > 0 && Model.OriginalAmount < v.MinOrderAmount;
                                <label class="vc-opt @(tooSmall ? "is-disabled" : "")">
                                    <input type="radio" name="voucherId" value="@v.VoucherId" @(Model.SelectedVoucherId == v.VoucherId ? "checked" : "") @(tooSmall ? "disabled" : "") onchange="this.form.submit()" />
                                    <span>
                                        <b>@v.Name — @(v.DiscountType == "Percent" ? $"giảm {v.Value:0.##}%" : $"giảm {v.Value:N0}₫")</b>
                                        <small>@(v.DiscountType == "Percent" && v.MaxDiscount is > 0 ? $"Tối đa {v.MaxDiscount:N0}₫ · " : "")@(v.MinOrderAmount is > 0 ? $"Đơn từ {v.MinOrderAmount:N0}₫ · " : "")Hạn dùng đến @(StoriesApiClient.ToLocal(v.ExpiresAt)?.ToString("dd/MM/yyyy"))</small>
                                    </span>
                                </label>
                            }
                        </div>
                        <noscript><button class="btn btn-outline btn-sm" type="submit" style="margin-top:10px;">Áp dụng voucher</button></noscript>
                    }
                </form>
            }

            @if (Model.HasDiscount)
            {
                <div class="vc-sum" aria-live="polite">
                    <div class="vc-row"><span>Giá gốc</span><s>@Model.OriginalAmount.ToString("N0")₫</s></div>
                    <div class="vc-row is-discount"><span>Giảm giá (voucher)</span><span>−@Model.DiscountAmount.ToString("N0")₫</span></div>
                    <div class="vc-row is-total"><span>Tổng thanh toán</span><b>@Model.Quote.Amount.ToString("N0")₫</b></div>
                </div>
            }

            <div class="checkout-actions">
                <form asp-action="Pay" method="post">
                    <input type="hidden" name="storyId" value="@story.Id" />
                    @if (Model.SelectedVoucherId.HasValue) { <input type="hidden" name="voucherId" value="@Model.SelectedVoucherId" /> }
                    <button type="submit" class="btn btn-brass">💳 Thanh toán @Model.Quote.Amount.ToString("N0")₫</button>
                </form>
                <a class="btn btn-outline" asp-controller="Stories" asp-action="Details" asp-route-id="@story.Id">← Quay lại truyện</a>
            </div>
        </div>
    </div>
</div>

<style>
    .checkout { display: grid; grid-template-columns: 170px 1fr; gap: 26px; align-items: start; padding: 26px; }
    .checkout-cover img, .checkout-cover .gen-cover { width: 170px; aspect-ratio: 2 / 3; object-fit: cover; border-radius: 10px; display: block; box-shadow: var(--shadow-sm); border: 1px solid var(--border); }
    .checkout-info h3 { font-size: 23px; margin-bottom: 4px; }
    .checkout-price { font-family: var(--font-display); font-size: 32px; font-weight: 700; color: var(--crimson); margin: 16px 0 14px; }
    .checkout-benefits { list-style: none; padding: 0; margin: 0 0 20px; line-height: 1.85; font-size: 14px; }
    .checkout-actions { display: flex; gap: 10px; flex-wrap: wrap; }
    @@media (max-width: 580px) {
        .checkout { grid-template-columns: 1fr; }
        .checkout-cover img, .checkout-cover .gen-cover { width: 130px; }
    }
</style>
