@model NotificationsVm
@{
    ViewData["Title"] = "Thông báo";
}
<div class="container section" style="max-width:760px;">
    <div class="section-head">
        <h2>🔔 Thông báo @(Model.UnreadCount > 0 ? $"({Model.UnreadCount} chưa đọc)" : "")</h2>
        @if (Model.UnreadCount > 0)
        {
            <form asp-action="ReadAll" method="post">
                <button type="submit" class="btn btn-outline btn-sm">✓ Đánh dấu tất cả đã đọc</button>
            </form>
        }
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="empty-state">
            <h3>Chưa có thông báo nào</h3>
            <p>Hãy bấm <b>“Theo dõi”</b> ở trang truyện để nhận thông báo ngay khi tác giả đăng chương mới.</p>
            <a class="btn btn-brass" asp-controller="Stories" asp-action="Browse">Khám phá truyện</a>
        </div>
    }
    else
    {
        <ul class="noti-list">
            @foreach (var n in Model.Items)
            {
                <li class="noti-item @(n.IsRead ? "" : "unread")">
                    <form asp-action="Open" method="post">
                        <input type="hidden" name="id" value="@n.NotificationId" />
                        <input type="hidden" name="storyId" value="@n.StoryId" />
                        <input type="hidden" name="chapterNumber" value="@n.ChapterNumber" />
                        <button type="submit" class="noti-btn">
                            <span class="noti-dot" aria-hidden="true"></span>
                            <span class="noti-text">
                                <span class="noti-msg">@n.Message</span>
                                <span class="noti-time">@StoriesApiClientTime(n.CreatedAt)</span>
                            </span>
                            <span class="noti-go">Xem →</span>
                        </button>
                    </form>
                </li>
            }
        </ul>

        @if (Model.PageCount > 1)
        {
            <nav class="pager" aria-label="Phân trang thông báo">
                @for (var p = 1; p <= Model.PageCount; p++)
                {
                    if (p == Model.Page) { <span class="current">@p</span> }
                    else { <a asp-action="Index" asp-route-page="@p">@p</a> }
                }
            </nav>
        }
    }
</div>

@functions {
    private static string StoriesApiClientTime(DateTime utc)
        => ReadManager.Web.Services.StoriesApiClient.ToLocal(utc)?.ToString("HH:mm dd/MM/yyyy") ?? "";
}

<style>
    .noti-list { list-style: none; padding: 0; margin: 0; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; box-shadow: var(--shadow-sm); }
    .noti-item + .noti-item { border-top: 1px solid var(--border); }
    .noti-item.unread { background: rgba(29, 78, 216, .04); }
    .noti-btn { display: flex; gap: 12px; align-items: center; width: 100%; padding: 14px 18px; background: none; border: 0; text-align: left; cursor: pointer; color: inherit; font: inherit; transition: background .15s; }
    .noti-btn:hover { background: var(--surface-2); }
    .noti-dot { width: 9px; height: 9px; border-radius: 50%; flex: none; background: var(--border); }
    .noti-item.unread .noti-dot { background: var(--brass); box-shadow: 0 0 0 3px rgba(29, 78, 216, .18); }
    .noti-item.unread .noti-msg { font-weight: 700; }
    .noti-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
    .noti-time { font-size: 12.5px; color: var(--muted); }
    .noti-go { font-size: 12.5px; font-weight: 600; color: var(--brass-2); white-space: nowrap; }
</style>
