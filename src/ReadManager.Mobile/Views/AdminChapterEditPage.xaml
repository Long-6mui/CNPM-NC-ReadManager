<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReadManager.Mobile.ViewModels"
             x:DataType="vm:AdminChapterEditViewModel"
             x:Class="ReadManager.Mobile.Views.AdminChapterEditPage"
             Title="{Binding PageTitle}"
             BackgroundColor="{StaticResource WebBg}">

    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,32" Spacing="14">

            <Button Text="{Binding StoryTitle, StringFormat='← {0}'}" Style="{StaticResource BtnLink}"
                    HorizontalOptions="Start" Command="{Binding GoBackCommand}" Padding="0,0" />

            <Border Style="{StaticResource Panel}">
                <VerticalStackLayout Spacing="12">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Số chương" Style="{StaticResource LblFieldName}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Style="{StaticResource WebEntry}" Text="{Binding NumberText}" Keyboard="Numeric" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Tiêu đề chương" Style="{StaticResource LblFieldName}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Style="{StaticResource WebEntry}" Text="{Binding Title}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nội dung" Style="{StaticResource LblFieldName}" />
                        <Border Style="{StaticResource FieldBorder}" Padding="12,6">
                            <Editor Text="{Binding Content}" HeightRequest="320" FontSize="14"
                                    Placeholder="Dán nội dung chương tại đây. Để trống dòng giữa các đoạn văn."
                                    PlaceholderColor="{StaticResource WebMuted}"
                                    TextColor="{StaticResource WebText}" BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Cho đọc miễn phí (truyện Miễn phí thì mọi chương luôn miễn phí)"
                               FontSize="13" TextColor="{StaticResource WebText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding IsFree}" OnColor="{StaticResource WebRoyal}" VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource WebBorder}" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Trạng thái" Style="{StaticResource LblFieldName}" />
                        <Border Style="{StaticResource FieldBorder}" HeightRequest="44">
                            <Picker ItemsSource="{Binding StatusOptions}" SelectedIndex="{Binding StatusIndex}"
                                    FontSize="14" TextColor="{StaticResource WebText}" BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource WebCrimson}" FontSize="13"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource WebRoyal}" />

                    <Button Text="Lưu chương" Style="{StaticResource BtnBrass}" Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
