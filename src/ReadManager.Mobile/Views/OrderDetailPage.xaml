<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReadManager.Mobile.ViewModels"
             xmlns:models="clr-namespace:ReadManager.Mobile.Models"
             x:DataType="vm:OrderDetailViewModel"
             x:Class="ReadManager.Mobile.Views.OrderDetailPage"
             Title="Đơn hàng"
             BackgroundColor="{StaticResource WebBg}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IconOverride="ic_back.png" />
    </Shell.BackButtonBehavior>

    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,32" Spacing="14">

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource WebRoyal}" />
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource WebCrimson}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <VerticalStackLayout IsVisible="{Binding Order, Converter={StaticResource StringToBoolConverter}}" Spacing="14">
                <Label Text="{Binding Order.Code}" Style="{StaticResource LblH2}" FontSize="22" />

                <Border Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding Order.TypeLabel}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource WebMuted}" />
                        <Label Text="{Binding Order.ItemName}" FontSize="17" FontAttributes="Bold"
                               FontFamily="{StaticResource SerifFont}" TextColor="{StaticResource WebText}" />
                        <BoxView HeightRequest="1" Color="{StaticResource WebBorder}" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" >
                            <Label Text="Thời hạn quyền đọc" FontSize="13" TextColor="{StaticResource WebMuted}" />
                            <Label Grid.Column="1" Text="{Binding Order.DurationText}" FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource WebText}" HorizontalTextAlignment="End" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="Số tiền" FontSize="13" TextColor="{StaticResource WebMuted}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Order.AmountText}" FontSize="22" FontAttributes="Bold"
                                   TextColor="{StaticResource WebText}" HorizontalTextAlignment="End" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="Trạng thái" FontSize="13" TextColor="{StaticResource WebMuted}" VerticalOptions="Center" />
                            <Border Grid.Column="1" HorizontalOptions="End" Padding="10,4" StrokeThickness="0"
                                    BackgroundColor="{Binding Order.StatusColor}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="{Binding Order.StatusLabel}" FontSize="12" FontAttributes="Bold" TextColor="White" />
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" >
                            <Label Text="Ngày tạo" FontSize="13" TextColor="{StaticResource WebMuted}" />
                            <Label Grid.Column="1" Text="{Binding Order.CreatedText}" FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource WebText}" HorizontalTextAlignment="End" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding Order.HasPaidAt}">
                            <Label Text="Ngày thanh toán" FontSize="13" TextColor="{StaticResource WebMuted}" />
                            <Label Grid.Column="1" Text="{Binding Order.PaidText}" FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource WebText}" HorizontalTextAlignment="End" />
                        </Grid>
                        <Label Text="{Binding Order.ExpiresText}" Style="{StaticResource LblMuted}"
                               IsVisible="{Binding Order.IsPending}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Đơn chờ thanh toán -->
                <Label Text="{Binding InfoMessage}" Style="{StaticResource LblMuted}"
                       IsVisible="{Binding InfoMessage, Converter={StaticResource StringToBoolConverter}}" />
                <Button Text="💳 Thanh toán" Style="{StaticResource BtnBrass}"
                        Command="{Binding PayCommand}" IsVisible="{Binding Order.ShowPay}" />
                <Button Text="Tải lại trạng thái" Style="{StaticResource BtnOutlineSm}" HeightRequest="44"
                        Command="{Binding LoadCommand}" />

                <Button Text="Xem truyện" Style="{StaticResource BtnOutlineSm}" HeightRequest="44"
                        Command="{Binding OpenStoryCommand}" IsVisible="{Binding Order.HasStory}" />
                <Button Text="Lịch sử thanh toán" Style="{StaticResource BtnLink}"
                        Command="{Binding OpenHistoryCommand}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
