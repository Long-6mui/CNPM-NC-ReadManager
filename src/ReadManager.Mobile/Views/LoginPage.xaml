<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReadManager.Mobile.ViewModels"
             x:DataType="vm:LoginViewModel"
             x:Class="ReadManager.Mobile.Views.LoginPage"
             Title="Đăng nhập"
             BackgroundColor="{StaticResource WebBg}">

    <ScrollView>
        <VerticalStackLayout Padding="20,28" Spacing="14">

            <Border Style="{StaticResource Panel}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Đăng nhập" Style="{StaticResource LblH2}" />
                    <Label Text="Chào mừng bạn quay lại Chữ &amp; Đêm." Style="{StaticResource LblMuted}" Margin="0,-8,0,4" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email" Style="{StaticResource LblFieldName}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Style="{StaticResource WebEntry}" Text="{Binding UsernameOrEmail}"
                                   Keyboard="Email" Placeholder="admin@doctruyen.local" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Mật khẩu" Style="{StaticResource LblFieldName}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Style="{StaticResource WebEntry}" Text="{Binding Password}"
                                   IsPassword="True" Placeholder="Nhập mật khẩu" />
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource WebCrimson}" FontSize="13"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource WebRoyal}" />

                    <Button Text="Đăng nhập" Style="{StaticResource BtnBrass}"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="Chưa có tài khoản?" Style="{StaticResource LblMuted}" VerticalOptions="Center" FontSize="12.5" />
                        <Button Text="Đăng ký ngay" Style="{StaticResource BtnLink}"
                                Command="{Binding GoToRegisterCommand}" Padding="2,0" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Button Text="← Về trang chủ" Style="{StaticResource BtnLink}"
                    Command="{Binding GoHomeCommand}" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
