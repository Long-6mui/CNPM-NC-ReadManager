<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReadManager.Mobile.ViewModels"
             x:DataType="vm:LoginViewModel"
             x:Class="ReadManager.Mobile.Views.LoginPage"
             Title="Đăng nhập"
             BackgroundColor="{DynamicResource WebBg}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IconOverride="ic_back.png" Command="{Binding GoHomeCommand}" />
    </Shell.BackButtonBehavior>

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Đầu trang thương hiệu (nền tối + logo đỏ như thanh trên của web) -->
            <Grid Padding="24,40,24,64">
                <Grid.Background>
                    <RadialGradientBrush Center="0.8,0.2" Radius="1.2">
                        <GradientStop Color="#2A1B3D" Offset="0.0" />
                        <GradientStop Color="#0A0D17" Offset="0.7" />
                        <GradientStop Color="#06080D" Offset="1.0" />
                    </RadialGradientBrush>
                </Grid.Background>
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Border WidthRequest="56" HeightRequest="56" StrokeThickness="0" HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E11D48" Offset="0.0" />
                                <GradientStop Color="#9F1239" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="#E11D48" Offset="0,8" Radius="18" Opacity="0.45" />
                        </Border.Shadow>
                        <Label Text="Đ" TextColor="White" FontFamily="BeVietnamExtraBold" FontSize="28"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="FOLIO" TextColor="White" FontFamily="BeVietnamExtraBold" FontSize="26"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Thư viện đọc truyện trực tuyến" TextColor="#A1A1AA" FontSize="13"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="20,0,20,28" Spacing="14" Margin="0,-40,0,0">

            <Border Style="{StaticResource Panel}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Đăng nhập" Style="{StaticResource LblH2}" />
                    <Label Text="Chào mừng bạn quay lại FOLIO." Style="{StaticResource LblMuted}" Margin="0,-8,0,4" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email" Style="{StaticResource LblFieldName}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Style="{StaticResource WebEntry}" Text="{Binding UsernameOrEmail}"
                                   Keyboard="Email" Placeholder="admin@doctruyen.local" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Mật khẩu" Style="{StaticResource LblFieldName}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Style="{StaticResource WebEntry}" Text="{Binding Password}"
                                   IsPassword="True" Placeholder="Nhập mật khẩu" />
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="{Binding ErrorMessage}" TextColor="{DynamicResource WebCrimson}" FontSize="13"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                       Color="{DynamicResource WebRoyal}" />

                    <Button Text="Đăng nhập" Style="{StaticResource BtnBrass}"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="Chưa có tài khoản?" Style="{StaticResource LblMuted}" VerticalOptions="Center" FontSize="12.5" />
                        <Button Text="Đăng ký ngay" Style="{StaticResource BtnLink}"
                                Command="{Binding GoToRegisterCommand}" Padding="2,0" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Button Text="⚙ Địa chỉ máy chủ" Style="{StaticResource BtnLink}"
                    Command="{Binding OpenServerSettingsCommand}" HorizontalOptions="Center" />

            <Button Text="← Về trang chủ" Style="{StaticResource BtnLink}"
                    Command="{Binding GoHomeCommand}" HorizontalOptions="Center" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
