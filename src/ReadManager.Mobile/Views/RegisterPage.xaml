<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReadManager.Mobile.ViewModels"
             x:DataType="vm:RegisterViewModel"
             x:Class="ReadManager.Mobile.Views.RegisterPage"
             Title="Đăng ký"
             BackgroundColor="{StaticResource WebBg}">

    <ScrollView>
        <VerticalStackLayout Padding="20,28" Spacing="14">

            <Border Style="{StaticResource Panel}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Tạo tài khoản" Style="{StaticResource LblH2}" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Tên hiển thị" Style="{StaticResource LblFieldName}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Style="{StaticResource WebEntry}" Text="{Binding DisplayName}" Placeholder="Tên của bạn" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email" Style="{StaticResource LblFieldName}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Style="{StaticResource WebEntry}" Text="{Binding Email}" Keyboard="Email" Placeholder="email@vidu.com" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Mật khẩu" Style="{StaticResource LblFieldName}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Style="{StaticResource WebEntry}" Text="{Binding Password}" IsPassword="True" Placeholder="Nhập mật khẩu" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nhập lại mật khẩu" Style="{StaticResource LblFieldName}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Style="{StaticResource WebEntry}" Text="{Binding ConfirmPassword}" IsPassword="True" Placeholder="Nhập lại mật khẩu" />
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource WebCrimson}" FontSize="13"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource WebRoyal}" />

                    <Button Text="Tạo tài khoản" Style="{StaticResource BtnBrass}"
                            Command="{Binding RegisterCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="Đã có tài khoản?" Style="{StaticResource LblMuted}" VerticalOptions="Center" FontSize="12.5" />
                        <Button Text="Đăng nhập" Style="{StaticResource BtnLink}"
                                Command="{Binding GoToLoginCommand}" Padding="2,0" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
