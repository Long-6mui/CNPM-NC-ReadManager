<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReadManager.Mobile.ViewModels"
             xmlns:models="clr-namespace:ReadManager.Mobile.Models"
             xmlns:ctl="clr-namespace:ReadManager.Mobile.Views.Controls"
             xmlns:fx="clr-namespace:ReadManager.Mobile.Behaviors"
             x:DataType="vm:StoryListViewModel"
             x:Class="ReadManager.Mobile.Views.StoryListPage"
             Title="Trang chủ"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource WebBg}">

    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- Thẻ truyện cuộn ngang ("Truyện nổi bật") — giống Views/Shared/_StoryCard.cshtml của web -->
            <DataTemplate x:Key="StoryCardTemplate" x:DataType="models:StorySummary">
                <VerticalStackLayout WidthRequest="140" Margin="0,0,12,14" Spacing="0" fx:Motion.Press="True">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StoryListViewModel}}, Path=GoToDetailCommand}"
                            CommandParameter="{Binding .}" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Border HeightRequest="205" Style="{StaticResource CoverFrame}">
                        <Grid>
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3F3A55" Offset="0.0" />
                                    <GradientStop Color="#1E1B2E" Offset="1.0" />
                                </LinearGradientBrush>
                            </Grid.Background>
                            <Label Text="{Binding Title}" IsVisible="{Binding HasNoCover}"
                                   FontFamily="{StaticResource SerifFont}" FontSize="15"
                                   TextColor="White" HorizontalTextAlignment="Center"
                                   VerticalOptions="Center" Margin="10" />
                            <Image Source="{Binding CoverUrl}" IsVisible="{Binding HasCover}" Aspect="AspectFill" />

                            <Border HorizontalOptions="Start" VerticalOptions="Start" Margin="7"
                                    Padding="7,3" StrokeThickness="0" BackgroundColor="{Binding AccessColor}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label Text="{Binding AccessLabel}" TextColor="White" FontSize="10" FontFamily="BeVietnamBold" />
                            </Border>
                        </Grid>
                    </Border>

                    <Label Text="{Binding Title}" Style="{StaticResource LblCardTitle}" Margin="0,9,0,0" />
                    <Label Text="{Binding MetaText}" Style="{StaticResource LblCardMeta}" Margin="0,3,0,0" />
                </VerticalStackLayout>
            </DataTemplate>

            <!-- Thẻ lưới 3 cột (Đề xuất cho bạn) -->
            <DataTemplate x:Key="GridCardTemplate" x:DataType="models:StorySummary">
                <VerticalStackLayout FlexLayout.Basis="33.3%" Padding="5,0,5,16" Spacing="0"
                                     fx:Motion.Press="True" fx:Motion.Reveal="True">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StoryListViewModel}}, Path=GoToDetailCommand}"
                            CommandParameter="{Binding .}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Border HeightRequest="162" Style="{StaticResource CoverFrame}">
                        <Grid>
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3F3A55" Offset="0.0" />
                                    <GradientStop Color="#1E1B2E" Offset="1.0" />
                                </LinearGradientBrush>
                            </Grid.Background>
                            <Label Text="{Binding Title}" IsVisible="{Binding HasNoCover}"
                                   FontFamily="{StaticResource SerifFont}" FontSize="13"
                                   TextColor="White" HorizontalTextAlignment="Center"
                                   VerticalOptions="Center" Margin="8" />
                            <Image Source="{Binding CoverUrl}" IsVisible="{Binding HasCover}" Aspect="AspectFill" />
                        </Grid>
                    </Border>
                    <Label Text="{Binding Title}" FontFamily="BeVietnamBold" FontSize="13.5" Margin="0,8,0,0"
                           TextColor="{DynamicResource WebText}" MaxLines="2" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding AuthorText}" Style="{StaticResource LblCardMeta}" Margin="0,2,0,0" />
                </VerticalStackLayout>
            </DataTemplate>

            <!-- Thẻ lưới 3 cột có huy chương / số hạng (Bảng xếp hạng, hạng 2 trở đi) -->
            <DataTemplate x:Key="RankCardTemplate" x:DataType="models:StorySummary">
                <VerticalStackLayout FlexLayout.Basis="33.3%" Padding="5,0,5,16" Spacing="0"
                                     fx:Motion.Press="True" fx:Motion.Reveal="True">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StoryListViewModel}}, Path=GoToDetailCommand}"
                            CommandParameter="{Binding .}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Grid>
                        <Border HeightRequest="162" Style="{StaticResource CoverFrame}">
                            <Grid>
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#3F3A55" Offset="0.0" />
                                        <GradientStop Color="#1E1B2E" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Grid.Background>
                                <Label Text="{Binding Title}" IsVisible="{Binding HasNoCover}"
                                       FontFamily="{StaticResource SerifFont}" FontSize="13"
                                       TextColor="White" HorizontalTextAlignment="Center"
                                       VerticalOptions="Center" Margin="8" />
                                <Image Source="{Binding CoverUrl}" IsVisible="{Binding HasCover}" Aspect="AspectFill" />
                            </Grid>
                        </Border>

                        <!-- Huy chương 2-3 -->
                        <Border IsVisible="{Binding IsTop3}" WidthRequest="30" HeightRequest="30" StrokeThickness="2"
                                Stroke="White" BackgroundColor="{Binding MedalColor}"
                                HorizontalOptions="Start" VerticalOptions="Start" Margin="-4,-6,0,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#000000" Offset="0,3" Radius="6" Opacity="0.35" />
                            </Border.Shadow>
                            <Label Text="{Binding RankText}" TextColor="White" FontFamily="BeVietnamExtraBold" FontSize="13"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <!-- Số hạng 4+ -->
                        <Border IsVisible="{Binding IsRankNumber}" WidthRequest="30" HeightRequest="30" StrokeThickness="0"
                                BackgroundColor="{DynamicResource WebSurface}"
                                HorizontalOptions="Start" VerticalOptions="Start" Margin="-4,-6,0,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#000000" Offset="0,3" Radius="6" Opacity="0.25" />
                            </Border.Shadow>
                            <Label Text="{Binding RankText}" TextColor="{DynamicResource WebText}" FontFamily="BeVietnamExtraBold"
                                   FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                    <Label Text="{Binding Title}" FontFamily="BeVietnamBold" FontSize="13.5" Margin="0,8,0,0"
                           TextColor="{DynamicResource WebText}" MaxLines="2" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding AuthorText}" Style="{StaticResource LblCardMeta}" Margin="0,2,0,0" />
                </VerticalStackLayout>
            </DataTemplate>

            <!-- Thẻ lớn 2 cột ("Mới ra mắt") — giống ảnh tham khảo -->
            <DataTemplate x:Key="BigCardTemplate" x:DataType="models:StorySummary">
                <VerticalStackLayout FlexLayout.Basis="50%" Padding="6,0,6,18" Spacing="0"
                                     fx:Motion.Press="True" fx:Motion.Reveal="True">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StoryListViewModel}}, Path=GoToDetailCommand}"
                            CommandParameter="{Binding .}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Border HeightRequest="236" Style="{StaticResource CoverFrame}">
                        <Grid>
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3F3A55" Offset="0.0" />
                                    <GradientStop Color="#1E1B2E" Offset="1.0" />
                                </LinearGradientBrush>
                            </Grid.Background>
                            <Label Text="{Binding Title}" IsVisible="{Binding HasNoCover}"
                                   FontFamily="{StaticResource SerifFont}" FontSize="16"
                                   TextColor="White" HorizontalTextAlignment="Center"
                                   VerticalOptions="Center" Margin="10" />
                            <Image Source="{Binding CoverUrl}" IsVisible="{Binding HasCover}" Aspect="AspectFill" />
                            <Border HorizontalOptions="Start" VerticalOptions="End" Margin="0,0,0,10" Padding="10,4"
                                    StrokeThickness="0" BackgroundColor="#E6FFF7D6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="0,10,0,10" />
                                </Border.StrokeShape>
                                <Label Text="{Binding ChapterBadge}" TextColor="#B45309" FontSize="11" FontFamily="BeVietnamBold" />
                            </Border>
                        </Grid>
                    </Border>
                    <Label Text="{Binding Title}" FontFamily="BeVietnamBold" FontSize="15.5" Margin="0,10,0,0"
                           TextColor="{DynamicResource WebText}" MaxLines="2" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding AuthorText}" FontSize="13" TextColor="{DynamicResource WebMuted}" Margin="0,3,0,0"
                           MaxLines="1" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
            </DataTemplate>

        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- Header tối, cùng màu với hero "sách bay" -->
        <ctl:AppHeader x:Name="Header" Grid.Row="0" IsHero="True" ShowBrand="True" Greeting="True"
                       Title="FOLIO" Subtitle="Đọc truyện mỗi ngày" />

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}"
                     RefreshColor="{DynamicResource WebRoyal}">
            <ScrollView>
                <VerticalStackLayout x:Name="Body" Spacing="0">

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                       Color="{DynamicResource WebRoyal}" Margin="0,16" />

                    <Label Text="{Binding ErrorMessage}" TextColor="{DynamicResource WebCrimson}" Padding="16,10"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

                    <!-- Không có truyện -->
                    <VerticalStackLayout IsVisible="{Binding ShowEmpty}" Padding="20,60" Spacing="6">
                        <Label Text="Không tìm thấy truyện phù hợp" Style="{StaticResource LblH2}"
                               FontSize="18" HorizontalTextAlignment="Center" />
                        <Label Text="Kéo xuống để tải lại, hoặc kiểm tra API đã chạy chưa."
                               Style="{StaticResource LblMuted}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding HasStories}" Spacing="0">

                        <!-- ============ HERO "SÁCH BAY" ============ -->
                        <ctl:FloatingHeroView x:Name="Hero" />

                        <!-- ============ THỐNG KÊ ============ -->
                        <Border Style="{StaticResource Panel}" Margin="16,-34,16,0" Padding="10,14" fx:Motion.Reveal="True">
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                                    <Label Text="{Binding TotalStories}" Style="{StaticResource LblH2}" HorizontalTextAlignment="Center" />
                                    <Label Text="Bộ truyện" FontSize="10.5" TextColor="{DynamicResource WebMuted}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                                    <Label Text="{Binding TotalGenres}" Style="{StaticResource LblH2}" HorizontalTextAlignment="Center" />
                                    <Label Text="Thể loại" FontSize="10.5" TextColor="{DynamicResource WebMuted}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                                    <Label Text="{Binding TotalChapters}" Style="{StaticResource LblH2}" HorizontalTextAlignment="Center" />
                                    <Label Text="Chương" FontSize="10.5" TextColor="{DynamicResource WebMuted}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="2">
                                    <Label Text="{Binding FreeCount}" Style="{StaticResource LblH2}" HorizontalTextAlignment="Center" />
                                    <Label Text="Đọc miễn phí" FontSize="10.5" TextColor="{DynamicResource WebMuted}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- ============ ĐỀ XUẤT CHO BẠN (theo sở thích) ============ -->
                        <VerticalStackLayout IsVisible="{Binding IsLoggedIn}" Padding="16,30,16,0" Spacing="10">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <BoxView Grid.Column="0" Style="{StaticResource SectionBar}" />
                                <Label Grid.Column="1" Text="⚡ Đề xuất cho bạn" Style="{StaticResource SectionTitle}" />
                                <Button Grid.Column="2" Text="Xem tất cả  ›" Style="{StaticResource BtnLink}"
                                        TextColor="{DynamicResource WebRoyal}"
                                        IsVisible="{Binding HasRecommendations}" Command="{Binding GoToRecommendedCommand}" />
                            </Grid>
                            <Label Text="{Binding RecommendCaption}" Style="{StaticResource LblMuted}" Margin="12,-6,0,0"
                                   IsVisible="{Binding HasPreferences}" />

                            <!-- Chưa chọn sở thích -->
                            <Border Style="{StaticResource Panel}" IsVisible="{Binding ShowPickPreferences}" fx:Motion.Reveal="True">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Chọn thể loại bạn thích" Style="{StaticResource LblH2}" FontSize="17" />
                                    <Label Text="Cho mình biết bạn thích đọc gì — mục này sẽ hiện ngay những truyện hợp gu của bạn."
                                           Style="{StaticResource LblMuted}" />
                                    <Button Text="Chọn sở thích" Style="{StaticResource BtnBrass}" Margin="0,4,0,0"
                                            Command="{Binding GoToPreferencesCommand}" />
                                </VerticalStackLayout>
                            </Border>

                            <ActivityIndicator IsRunning="{Binding IsRecommendBusy}" IsVisible="{Binding IsRecommendBusy}"
                                               Color="{DynamicResource WebRoyal}" />

                            <FlexLayout Wrap="Wrap" JustifyContent="Start" Margin="-5,4,-5,0"
                                        IsVisible="{Binding HasRecommendations}"
                                        BindableLayout.ItemsSource="{Binding Recommended}"
                                        BindableLayout.ItemTemplate="{StaticResource GridCardTemplate}" />
                        </VerticalStackLayout>

                        <!-- ============ BẢNG XẾP HẠNG + LỌC THEO THỂ LOẠI ============ -->
                        <VerticalStackLayout Padding="16,26,16,0" Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <BoxView Grid.Column="0" Style="{StaticResource SectionBar}" />
                                <Label Grid.Column="1" Text="🔥 Bảng xếp hạng" Style="{StaticResource SectionTitle}" />
                                <!-- Kỳ xếp hạng -->
                                <Border Grid.Column="2" Style="{StaticResource Chip}" Padding="12,6" VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding PickPeriodCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label FontFamily="BeVietnamSemiBold" FontSize="13" TextColor="{DynamicResource WebRoyal}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding PeriodName}" />
                                                <Span Text="  ▾" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Border>
                            </Grid>

                            <!-- Hàng thể loại (giống ảnh tham khảo: Tất cả | Ngôn Tình | Đô Thị ... ▾) -->
                            <Border BackgroundColor="{DynamicResource WebSurface}" Stroke="{DynamicResource WebBorder}"
                                    StrokeThickness="1" Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*,1,48">
                                    <ScrollView Grid.Column="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                        <HorizontalStackLayout Padding="6,0" BindableLayout.ItemsSource="{Binding RankGenres}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:ChipItem">
                                                    <Label Text="{Binding Name}" Padding="12,13" FontSize="15"
                                                           FontFamily="{Binding FontFamily}" TextColor="{Binding AccentText}"
                                                           fx:Motion.Press="True">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StoryListViewModel}}, Path=SelectRankGenreCommand}"
                                                                CommandParameter="{Binding .}" />
                                                        </Label.GestureRecognizers>
                                                    </Label>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </HorizontalStackLayout>
                                    </ScrollView>
                                    <BoxView Grid.Column="1" Color="{DynamicResource WebBorder}" Margin="0,10" />
                                    <Label Grid.Column="2" Text="▾" FontSize="20"
                                           TextColor="{DynamicResource WebRoyal}"
                                           HorizontalOptions="Center" VerticalOptions="Center" fx:Motion.Press="True">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding PickRankGenreCommand}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>

                            <!-- Tiêu chí: Lượt đọc | Theo dõi nhiều | Nổi bật nhất -->
                            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding RankMetrics}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:ChipItem">
                                            <Border Style="{StaticResource Chip}" BackgroundColor="{Binding Background}" Stroke="{Binding Stroke}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StoryListViewModel}}, Path=SelectRankMetricCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="{Binding Name}" Style="{StaticResource ChipText}" TextColor="{Binding Foreground}" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </ScrollView>

                            <ActivityIndicator IsRunning="{Binding IsRankingBusy}" IsVisible="{Binding IsRankingBusy}"
                                               Color="{DynamicResource WebRoyal}" />

                            <VerticalStackLayout x:Name="RankingBlock" IsVisible="{Binding HasRanking}" Spacing="16">
                                <!-- Hạng 1: thẻ lớn -->
                                <Border Style="{StaticResource Panel}" Padding="12" fx:Motion.Press="True">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToDetailCommand}" CommandParameter="{Binding RankingTop}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="118,*" ColumnSpacing="14">
                                        <Grid Grid.Column="0">
                                            <Border HeightRequest="168" Style="{StaticResource CoverFrame}">
                                                <Grid>
                                                    <Grid.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#E11D48" Offset="0.0" />
                                                            <GradientStop Color="#7F1D1D" Offset="1.0" />
                                                        </LinearGradientBrush>
                                                    </Grid.Background>
                                                    <Label Text="{Binding RankingTop.Title}" IsVisible="{Binding RankingTop.HasNoCover}"
                                                           FontFamily="{StaticResource SerifFont}" FontSize="14" TextColor="White"
                                                           HorizontalTextAlignment="Center" VerticalOptions="Center" Margin="8" />
                                                    <Image Source="{Binding RankingTop.CoverUrl}" IsVisible="{Binding RankingTop.HasCover}"
                                                           Aspect="AspectFill" />
                                                </Grid>
                                            </Border>
                                            <Border WidthRequest="34" HeightRequest="34" StrokeThickness="2" Stroke="White"
                                                    BackgroundColor="#F59E0B" HorizontalOptions="Start" VerticalOptions="Start"
                                                    Margin="-6,-8,0,0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="17" />
                                                </Border.StrokeShape>
                                                <Border.Shadow>
                                                    <Shadow Brush="#F59E0B" Offset="0,3" Radius="10" Opacity="0.6" />
                                                </Border.Shadow>
                                                <Label Text="1" TextColor="White" FontFamily="BeVietnamExtraBold" FontSize="15"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                        <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                            <Label Text="{Binding RankingTop.Title}" FontFamily="BeVietnamExtraBold" FontSize="17"
                                                   TextColor="{DynamicResource WebText}" MaxLines="2" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding RankingTop.AuthorText}" FontFamily="BeVietnamSemiBold" FontSize="13.5"
                                                   TextColor="{DynamicResource WebRoyal2}" MaxLines="1" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding RankingTop.Blurb}" FontSize="13" LineHeight="1.3"
                                                   TextColor="{DynamicResource WebMuted}" MaxLines="4" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding RankingTop.MetricText}" FontSize="12" FontFamily="BeVietnamSemiBold"
                                                   TextColor="{DynamicResource WebAmber}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>

                                <!-- Hạng 2..10: lưới 3 cột -->
                                <FlexLayout Wrap="Wrap" JustifyContent="Start" Margin="-5,6,-5,0"
                                            BindableLayout.ItemsSource="{Binding RankingRest}"
                                            BindableLayout.ItemTemplate="{StaticResource RankCardTemplate}" />
                            </VerticalStackLayout>

                            <Label Text="Chưa có dữ liệu xếp hạng cho lựa chọn này." Style="{StaticResource LblMuted}"
                                   HorizontalTextAlignment="Center" Margin="0,10" IsVisible="{Binding ShowRankingEmpty}" />
                        </VerticalStackLayout>

                        <!-- ============ MỚI RA MẮT (2 hàng x 2 truyện, "Xem thêm" -> trang riêng) ============ -->
                        <VerticalStackLayout Padding="16,26,16,0" Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <BoxView Grid.Column="0" Style="{StaticResource SectionBar}" />
                                <Label Grid.Column="1" Text="🎉 Mới ra mắt" Style="{StaticResource SectionTitle}" />
                                <Button Grid.Column="2" Text="Xem thêm  ›" Style="{StaticResource BtnLink}"
                                        TextColor="{DynamicResource WebRoyal}" Command="{Binding GoToNewReleasesCommand}" />
                            </Grid>
                            <FlexLayout Wrap="Wrap" JustifyContent="Start" Margin="-6,0"
                                        BindableLayout.ItemsSource="{Binding NewReleases}"
                                        BindableLayout.ItemTemplate="{StaticResource BigCardTemplate}" />
                        </VerticalStackLayout>

                        <!-- ============ TRUYỆN NỔI BẬT (3 tab) ============ -->
                        <VerticalStackLayout Padding="16,22,0,0" Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <BoxView Grid.Column="0" Style="{StaticResource SectionBar}" />
                                <Label Grid.Column="1" Text="Truyện nổi bật" Style="{StaticResource SectionTitle}" />
                            </Grid>
                            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding FeaturedTabs}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:ChipItem">
                                        <Border Style="{StaticResource Chip}" BackgroundColor="{Binding Background}" Stroke="{Binding Stroke}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StoryListViewModel}}, Path=SelectFeaturedTabCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding Name}" Style="{StaticResource ChipText}" TextColor="{Binding Foreground}" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                <HorizontalStackLayout Padding="0,4,16,0"
                                                       BindableLayout.ItemsSource="{Binding TabStories}"
                                                       BindableLayout.ItemTemplate="{StaticResource StoryCardTemplate}" />
                            </ScrollView>
                        </VerticalStackLayout>

                        <!-- ============ KÊU GỌI ĐĂNG NHẬP (khách) ============ -->
                        <Border IsVisible="{Binding IsGuest}" Margin="16,22,16,32" Padding="22" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#17112C" Offset="0.0" />
                                    <GradientStop Color="#2A1B3D" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Tham gia cộng đồng đọc truyện" TextColor="White"
                                       FontFamily="{StaticResource SerifFont}" FontSize="20" />
                                <Label Text="Đăng ký để chọn thể loại yêu thích và nhận đề xuất truyện hợp gu." TextColor="#CBD5E1" FontSize="14" />
                                <HorizontalStackLayout Spacing="10" Margin="0,8,0,0">
                                    <Button Text="Đăng nhập" Style="{StaticResource BtnLight}"
                                            Command="{Binding GoToLoginCommand}" />
                                    <Button Text="Đăng ký" Style="{StaticResource BtnAmber}"
                                            Command="{Binding GoToRegisterCommand}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        <ContentView HeightRequest="24" />

                    </VerticalStackLayout>
