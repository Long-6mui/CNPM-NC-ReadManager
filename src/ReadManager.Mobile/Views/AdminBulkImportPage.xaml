<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReadManager.Mobile.ViewModels"
             xmlns:models="clr-namespace:ReadManager.Mobile.Models"
             x:DataType="vm:AdminBulkImportViewModel"
             x:Class="ReadManager.Mobile.Views.AdminBulkImportPage"
             Title="Tải nhiều chương"
             BackgroundColor="{StaticResource WebBg}">

    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,32" Spacing="14">

            <Button Text="{Binding StoryTitle, StringFormat='← {0}'}" Style="{StaticResource BtnLink}"
                    HorizontalOptions="Start" Command="{Binding GoBackCommand}" Padding="0,0" />

            <!-- Chọn file / dán văn bản -->
            <Border Style="{StaticResource Panel}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Chọn file .txt / .zip, hoặc dán văn bản, hoặc cả hai." Style="{StaticResource LblMuted}" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="File chương" Style="{StaticResource LblFieldName}" />
                        <Button Text="Chọn file…" Style="{StaticResource BtnOutlineSm}" HorizontalOptions="Start"
                                Command="{Binding PickFilesCommand}" />
                        <Label Text="{Binding FileNamesText}" Style="{StaticResource LblMuted}" FontSize="12" />
                        <Button Text="Bỏ chọn file" Style="{StaticResource BtnLink}" HorizontalOptions="Start"
                                Command="{Binding ClearFilesCommand}" IsVisible="{Binding HasFiles}" Padding="0,0" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Dán nội dung nhiều chương" Style="{StaticResource LblFieldName}" />
                        <Border Style="{StaticResource FieldBorder}" Padding="12,6">
                            <Editor Text="{Binding RawText}" HeightRequest="220" FontSize="14"
                                    TextColor="{StaticResource WebText}" BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Cho đọc miễn phí (áp dụng cho mọi chương)" FontSize="13"
                               TextColor="{StaticResource WebText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding MarkFree}" OnColor="{StaticResource WebRoyal}" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Công khai ngay (tắt = lưu nháp)" FontSize="13"
                               TextColor="{StaticResource WebText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding Publish}" OnColor="{StaticResource WebRoyal}" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Ghi đè chương trùng số (tắt = bỏ qua)" FontSize="13"
                               TextColor="{StaticResource WebText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding OverwriteExisting}" OnColor="{StaticResource WebRoyal}" VerticalOptions="Center" />
                    </Grid>

                    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource WebCrimson}" FontSize="13"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource WebRoyal}" />

                    <Button Text="Kiểm tra" Style="{StaticResource BtnOutlineSm}" HeightRequest="44"
                            Command="{Binding CheckCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                    <Button Text="Lưu các chương" Style="{StaticResource BtnBrass}"
                            Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" Opacity="1">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding CanSave}" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </VerticalStackLayout>
            </Border>

            <!-- Kết quả kiểm tra -->
            <Label Text="{Binding ResultMessage}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource WebText}"
                   IsVisible="{Binding ResultMessage, Converter={StaticResource StringToBoolConverter}}" />

            <Border Style="{StaticResource Panel}" Padding="14" BackgroundColor="#1AE5484D" Stroke="#73E5484D"
                    IsVisible="{Binding HasErrors}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Lỗi (cần sửa trước khi lưu)" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource WebCrimson}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Errors}" Spacing="3">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding ., StringFormat='• {0}'}" FontSize="13" TextColor="{StaticResource WebCrimson}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Panel}" Padding="14" BackgroundColor="#1FDCA01E" Stroke="#80DCA01E"
                    IsVisible="{Binding HasWarnings}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Cảnh báo (vẫn lưu được)" FontAttributes="Bold" FontSize="13" TextColor="#8A5A00" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Warnings}" Spacing="3">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding ., StringFormat='• {0}'}" FontSize="13" TextColor="#8A5A00" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Bảng xem trước -->
            <Border Style="{StaticResource Panel}" Padding="0" IsVisible="{Binding HasPreview}">
                <VerticalStackLayout>
                    <Label Text="Xem trước các chương" FontSize="15" FontAttributes="Bold"
                           TextColor="{StaticResource WebText}" Padding="16,14,16,8" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Preview}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ChapterPreviewRow">
                                <VerticalStackLayout Padding="16,10" Spacing="2">
                                    <BoxView HeightRequest="1" Color="{StaticResource WebBorder}" Margin="0,0,0,8" />
                                    <Label Text="{Binding Header}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource WebText}"
                                           MaxLines="2" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Detail}" FontSize="12" TextColor="{Binding ActionColor}" />
                                    <Label Text="{Binding ContentPreview}" Style="{StaticResource LblCardMeta}" />
                                    <Label Text="{Binding ProblemText}" FontSize="12" TextColor="{Binding ActionColor}"
                                           IsVisible="{Binding HasProblems}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
