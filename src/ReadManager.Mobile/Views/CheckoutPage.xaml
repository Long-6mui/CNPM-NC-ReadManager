<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReadManager.Mobile.ViewModels"
             xmlns:models="clr-namespace:ReadManager.Mobile.Models"
             xmlns:fx="clr-namespace:ReadManager.Mobile.Behaviors"
             x:DataType="vm:CheckoutViewModel"
             x:Class="ReadManager.Mobile.Views.CheckoutPage"
             Title="Thanh toán"
             BackgroundColor="{DynamicResource WebBg}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IconOverride="ic_back.png" />
    </Shell.BackButtonBehavior>

    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,32" Spacing="14">

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource WebRoyal}" />
            <Label Text="{Binding ErrorMessage}" TextColor="{DynamicResource WebCrimson}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <VerticalStackLayout IsVisible="{Binding ShowContent}" Spacing="14">
                <Label Text="{Binding Heading}" Style="{StaticResource LblH2}" FontSize="22" />

                <Border Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="12">

                        <!-- Bìa (chỉ khi mua truyện) -->
                        <Border HeightRequest="150" WidthRequest="100" HorizontalOptions="Start" StrokeThickness="1"
                                Stroke="{DynamicResource WebBorder}" IsVisible="{Binding HasCover}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Image Source="{Binding CoverUrl}" Aspect="AspectFill" />
                        </Border>

                        <Label Text="{Binding Title}" Style="{StaticResource LblH2}" FontSize="20" />
                        <Label Text="{Binding Subtitle}" Style="{StaticResource LblMuted}"
                               IsVisible="{Binding Subtitle, Converter={StaticResource StringToBoolConverter}}" />

                        <!-- Giá: giá gốc gạch ngang + giá sau giảm -->
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="{Binding AmountText}" FontSize="30" VerticalOptions="End"
                                   FontFamily="{StaticResource SerifFont}" TextColor="{DynamicResource WebCrimson}" />
                            <Label Text="{Binding OriginalText}" FontSize="16" TextDecorations="Strikethrough" Margin="0,0,0,6"
                                   TextColor="{DynamicResource WebMuted}" VerticalOptions="End" IsVisible="{Binding HasSaving}" />
                        </HorizontalStackLayout>
                        <Border IsVisible="{Binding HasSaving}" Style="{StaticResource Pill}" BackgroundColor="#DCFCE7">
                            <Label Text="{Binding DiscountText}" FontSize="12.5" FontFamily="BeVietnamBold" TextColor="#15803D" />
                        </Border>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Benefits}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding .}" FontSize="13.5" TextColor="{DynamicResource WebText}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- ===== CHỌN MÃ GIẢM GIÁ =====
                             Mua truyện: voucher đổi bằng xu. Mua gói: mã giảm % nhận từ chuỗi đọc. -->
                        <BoxView HeightRequest="1" Color="{DynamicResource WebBorder}" Margin="0,4" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding DiscountTitle}" FontFamily="BeVietnamBold" FontSize="15"
                                   TextColor="{DynamicResource WebText}" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Kho mã ›" Style="{StaticResource BtnLink}"
                                    TextColor="{DynamicResource WebRoyal}" Command="{Binding OpenWalletCommand}" />
                        </Grid>
                        <Label Text="{Binding DiscountHint}" Style="{StaticResource LblCardMeta}" Margin="0,-8,0,0" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Discounts}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:DiscountOption">
                                    <Border Padding="0" StrokeThickness="1.5" Stroke="{Binding Stroke}" BackgroundColor="{Binding Background}"
                                            Opacity="{Binding Opacity}" fx:Motion.Press="True">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CheckoutViewModel}}, Path=SelectDiscountCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto,*,Auto" MinimumHeightRequest="60">
                                            <!-- Cuống vé -->
                                            <Grid Grid.Column="0" WidthRequest="70" BackgroundColor="{Binding StubColor}" IsVisible="{Binding HasBadge}">
                                                <Label Text="{Binding Badge}" TextColor="White" FontFamily="BeVietnamExtraBold" FontSize="16"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Grid>
                                            <VerticalStackLayout Grid.Column="1" Padding="12,10" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Title}" FontFamily="BeVietnamBold" FontSize="14"
                                                       TextColor="{DynamicResource WebText}" MaxLines="2" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Detail}" FontSize="12" TextColor="{DynamicResource WebMuted}"
                                                       MaxLines="2" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Reason}" FontSize="12" FontFamily="BeVietnamSemiBold"
                                                       TextColor="{DynamicResource WebCrimson}" IsVisible="{Binding HasReason}" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="2" WidthRequest="26" HeightRequest="26" Margin="0,0,12,0" StrokeThickness="2"
                                                    Stroke="{Binding Stroke}" VerticalOptions="Center">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="13" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Check}" TextColor="#E11D48" FontFamily="BeVietnamExtraBold" FontSize="14"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- Chưa có mã -->
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasNoDiscounts}">
                            <Label Text="Bạn chưa có mã phù hợp." Style="{StaticResource LblMuted}" FontSize="13" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Đổi voucher bằng xu" Style="{StaticResource BtnLink}"
                                    TextColor="{DynamicResource WebRoyal}" Command="{Binding OpenShopCommand}" IsVisible="{Binding IsStory}" />
                        </Grid>

                        <Label Text="{Binding Notice}" Style="{StaticResource LblMuted}" TextColor="#B7791F"
                               IsVisible="{Binding Notice, Converter={StaticResource StringToBoolConverter}}" />
                        <Label Text="{Binding CannotBuyMessage}" TextColor="{DynamicResource WebCrimson}" FontFamily="BeVietnamBold"
                               IsVisible="{Binding CannotBuyMessage, Converter={StaticResource StringToBoolConverter}}" />

                        <Button Text="{Binding ConfirmText}" Style="{StaticResource BtnBrass}" Margin="0,6,0,0"
                                Command="{Binding ConfirmCommand}" IsVisible="{Binding CanBuy}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
