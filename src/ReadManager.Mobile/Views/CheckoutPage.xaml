<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReadManager.Mobile.ViewModels"
             xmlns:models="clr-namespace:ReadManager.Mobile.Models"
             x:DataType="vm:CheckoutViewModel"
             x:Class="ReadManager.Mobile.Views.CheckoutPage"
             Title="Thanh toán"
             BackgroundColor="{StaticResource WebBg}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IconOverride="ic_back.png" />
    </Shell.BackButtonBehavior>

    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,32" Spacing="14">

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource WebRoyal}" />
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource WebCrimson}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <VerticalStackLayout IsVisible="{Binding ShowContent}" Spacing="14">
                <Label Text="{Binding Heading}" Style="{StaticResource LblH2}" FontSize="22" />

                <Border Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="12">

                        <!-- Bìa (chỉ khi mua truyện) -->
                        <Border HeightRequest="150" WidthRequest="100" HorizontalOptions="Start" StrokeThickness="1"
                                Stroke="{StaticResource WebBorder}" IsVisible="{Binding HasCover}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="4" />
                            </Border.StrokeShape>
                            <Image Source="{Binding CoverUrl}" Aspect="AspectFill" />
                        </Border>

                        <Label Text="{Binding Title}" Style="{StaticResource LblH2}" FontSize="20" />
                        <Label Text="{Binding Subtitle}" Style="{StaticResource LblMuted}"
                               IsVisible="{Binding Subtitle, Converter={StaticResource StringToBoolConverter}}" />

                        <Label Text="{Binding AmountText}" FontSize="30" FontAttributes="Bold"
                               FontFamily="{StaticResource SerifFont}" TextColor="{StaticResource WebCrimson}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Benefits}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding .}" FontSize="13.5" TextColor="{StaticResource WebText}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="{Binding Notice}" Style="{StaticResource LblMuted}" TextColor="#B7791F"
                               IsVisible="{Binding Notice, Converter={StaticResource StringToBoolConverter}}" />
                        <Label Text="{Binding CannotBuyMessage}" TextColor="{StaticResource WebCrimson}" FontAttributes="Bold"
                               IsVisible="{Binding CannotBuyMessage, Converter={StaticResource StringToBoolConverter}}" />

                        <Button Text="{Binding ConfirmText}" Style="{StaticResource BtnBrass}" Margin="0,6,0,0"
                                Command="{Binding ConfirmCommand}" IsVisible="{Binding CanBuy}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
