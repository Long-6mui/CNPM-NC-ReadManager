<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReadManager.Mobile.ViewModels"
             x:DataType="vm:ChapterReaderViewModel"
             x:Class="ReadManager.Mobile.Views.ChapterReaderPage"
             Title="{Binding Chapter.Title}"
             BackgroundColor="{DynamicResource WebBg}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IconOverride="ic_back.png" />
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="*,Auto">

        <ScrollView x:Name="ReaderScroll" Grid.Row="0" Scrolled="OnScrolled" SizeChanged="OnReaderSizeChanged">
            <VerticalStackLayout Padding="22,18,22,28" Spacing="14">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

                <Label Text="{Binding Chapter.Title, StringFormat='Chương {0}'}"
                       FontSize="22" FontFamily="BeVietnamExtraBold" TextColor="{DynamicResource WebText}" Margin="0,4,0,2" />

                <Label Text="{Binding ErrorMessage}" TextColor="{DynamicResource WebCrimson}" />
                <Label Text="{Binding ProgressMessage}" FontSize="12" TextColor="{DynamicResource WebMuted}" />
                <Label IsVisible="{Binding IsReadable}" Text="{Binding Chapter.Content}"
                       FontSize="17" TextColor="{DynamicResource WebText}"
                       LineHeight="1.65" />

                <!-- Chương trả phí chưa mở khóa (giống web: Stories/Read.cshtml) -->
                <Border Style="{StaticResource Panel}" IsVisible="{Binding IsLocked}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="🔒 Chương này dành cho độc giả đã mở khóa" Style="{StaticResource LblH2}" FontSize="18" />
                        <Label Text="Nội dung trả phí đang khóa. Mua trọn bộ truyện để đọc vĩnh viễn tất cả các chương, hoặc mua gói đọc."
                               Style="{StaticResource LblMuted}" />
                        <Button Text="🛒 Mua trọn bộ truyện" Style="{StaticResource BtnBrass}"
                                Command="{Binding BuyStoryCommand}" Margin="0,6,0,0" />
                        <Button Text="Xem các gói đọc" Style="{StaticResource BtnOutlineSm}" HeightRequest="44"
                                Command="{Binding OpenPlansCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Bình luận / báo cáo chương (Sprint 3) -->
                <Button Text="💬 Bình luận chương này" Style="{StaticResource BtnOutlineSm}" HeightRequest="44"
                        Command="{Binding OpenCommentsCommand}" IsVisible="{Binding IsReadable}" Margin="0,12,0,0" />
                <Button Text="⚑ Báo cáo chương" Style="{StaticResource BtnLink}" HorizontalOptions="Start"
                        TextColor="{DynamicResource WebCrimson}" Command="{Binding ReportChapterCommand}"
                        IsVisible="{Binding IsReadable}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Nhắc phần thưởng: đọc hết chương (tối thiểu 1 phút) -> +10 xu và giữ chuỗi 🔥 -->
        <Border x:Name="RewardPill" Grid.Row="0" IsVisible="False" InputTransparent="True"
                HorizontalOptions="Center" VerticalOptions="End" Margin="16,0,16,14" Padding="16,9"
                StrokeThickness="0" BackgroundColor="#E617112C">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,6" Radius="14" Opacity="0.3" />
            </Border.Shadow>
            <Label x:Name="RewardLabel" TextColor="White" FontSize="13" FontFamily="BeVietnamSemiBold"
                   HorizontalTextAlignment="Center" />
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" Padding="16,12" ColumnSpacing="12" BackgroundColor="{DynamicResource WebSurface}">
            <Button Grid.Column="0" Style="{StaticResource BtnOutlineSm}" HeightRequest="46"
                    Text="◀ Chương trước"
                    Command="{Binding GoToPreviousCommand}"
                    IsEnabled="{Binding Chapter.PreviousChapterId, Converter={StaticResource StringToBoolConverter}}" />

            <Button Grid.Column="1" Style="{StaticResource BtnBrass}"
                    Text="Chương sau ▶"
                    Command="{Binding GoToNextCommand}"
                    IsEnabled="{Binding Chapter.NextChapterId, Converter={StaticResource StringToBoolConverter}}" />
        </Grid>

    </Grid>
</ContentPage>
