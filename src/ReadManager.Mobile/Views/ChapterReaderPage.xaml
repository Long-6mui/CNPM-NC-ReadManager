<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReadManager.Mobile.ViewModels"
             x:DataType="vm:ChapterReaderViewModel"
             x:Class="ReadManager.Mobile.Views.ChapterReaderPage"
             Title="{Binding Chapter.Title}">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

                <Label Text="{Binding Chapter.Title, StringFormat='Chương {0}'}"
                       FontSize="18" FontAttributes="Bold" />

                <Label Text="{Binding Chapter.Content}"
                       FontSize="16"
                       LineHeight="1.4" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" Padding="16" ColumnSpacing="12">
            <Button Grid.Column="0"
                    Text="◀ Chương trước"
                    Command="{Binding GoToPreviousCommand}"
                    IsEnabled="{Binding Chapter.PreviousChapterId, Converter={StaticResource StringToBoolConverter}}" />

            <Button Grid.Column="1"
                    Text="Chương sau ▶"
                    Command="{Binding GoToNextCommand}"
                    IsEnabled="{Binding Chapter.NextChapterId, Converter={StaticResource StringToBoolConverter}}" />
        </Grid>

    </Grid>
</ContentPage>
