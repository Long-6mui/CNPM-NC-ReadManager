<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReadManager.Mobile.ViewModels"
             xmlns:models="clr-namespace:ReadManager.Mobile.Models"
             xmlns:ctl="clr-namespace:ReadManager.Mobile.Views.Controls"
             xmlns:fx="clr-namespace:ReadManager.Mobile.Behaviors"
             x:DataType="vm:LibraryViewModel"
             x:Class="ReadManager.Mobile.Views.LibraryPage"
             Title="Tủ sách"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource WebBg}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="0">
        <ctl:AppHeader x:Name="Header" Grid.Row="0" Title="Tủ sách" />

        <!-- Ô tìm trong tủ sách -->
        <Grid Grid.Row="1" BackgroundColor="{DynamicResource WebHeader}" Padding="16,12,16,4">
            <Border HeightRequest="46" Padding="14,0" StrokeThickness="1" Stroke="{DynamicResource WebBorder}"
                    BackgroundColor="{DynamicResource WebField}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="23" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Text="🔍" FontSize="15" VerticalOptions="Center" Opacity="0.7" />
                    <Entry Grid.Column="1" Style="{StaticResource WebEntry}" Text="{Binding SearchText}"
                           Placeholder="Tìm tên truyện trong tủ sách..." ReturnType="Search" />
                    <Label Grid.Column="2" Text="✕" FontSize="14" TextColor="{DynamicResource WebMuted}" Padding="6"
                           VerticalOptions="Center"
                           IsVisible="{Binding SearchText, Converter={StaticResource StringToBoolConverter}}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ClearSearchCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>
        </Grid>

        <!-- Thanh tab gạch chân: Đang đọc | Theo dõi | Yêu thích | Đã mua | Đã xem
             (màu tính sẵn trong ChipItem — bấm tab nào thì chỉ tab đó đỏ) -->
        <Grid Grid.Row="2" BackgroundColor="{DynamicResource WebHeader}" RowDefinitions="Auto,1">
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Padding="8,0" BindableLayout.ItemsSource="{Binding Tabs}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ChipItem">
                            <VerticalStackLayout Padding="12,12,12,0" Spacing="9" fx:Motion.Press="True">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=SelectTabCommand}"
                                        CommandParameter="{Binding .}" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Label Text="{Binding Name}" FontSize="15.5" FontFamily="{Binding FontFamily}"
                                       TextColor="{Binding AccentText}" HorizontalTextAlignment="Center" />
                                <BoxView HeightRequest="3" CornerRadius="2" Color="{Binding IndicatorColor}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>
            <BoxView Grid.Row="1" Color="{DynamicResource WebBorder}" />
        </Grid>

        <!-- Số truyện + nút xóa lịch sử -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Padding="16,12,16,0" IsVisible="{Binding ShowList}">
            <Label Grid.Column="0" Text="{Binding CountText}" Style="{StaticResource LblMuted}" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="Xóa lịch sử" Style="{StaticResource BtnLink}"
                    Command="{Binding ClearHistoryCommand}" IsVisible="{Binding ShowClear}" />
        </Grid>

        <ActivityIndicator Grid.Row="4" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           Color="{DynamicResource WebRoyal}" VerticalOptions="Start" Margin="0,20" />

        <!-- Danh sách -->
        <CollectionView Grid.Row="4" ItemsSource="{Binding Items}" SelectionMode="None" Margin="16,8,16,0"
                        IsVisible="{Binding ShowList}">
            <CollectionView.Footer>
                <!-- khoảng trống cuối danh sách (không dùng BoxView: trên Android BoxView trong Footer bị hiện màu đen) -->
                <ContentView HeightRequest="24" />
            </CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:LibraryEntry">
                    <Border Style="{StaticResource Panel}" Padding="12" Margin="0,0,0,12" fx:Motion.Reveal="True">
                        <Grid ColumnDefinitions="76,*" ColumnSpacing="14">
                            <!-- Bìa -->
                            <Border Grid.Column="0" HeightRequest="108" Style="{StaticResource CoverFrame}" VerticalOptions="Start">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=OpenCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid>
                                    <Grid.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3F3A55" Offset="0.0" />
                                            <GradientStop Color="#1E1B2E" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Grid.Background>
                                    <Label Text="{Binding Title}" IsVisible="{Binding HasNoCover}"
                                           FontFamily="{StaticResource SerifFont}" FontSize="10"
                                           TextColor="White" HorizontalTextAlignment="Center"
                                           VerticalOptions="Center" Margin="4" />
                                    <Image Source="{Binding CoverUrl}" IsVisible="{Binding HasCover}" Aspect="AspectFill" />
                                </Grid>
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding Title}" FontFamily="BeVietnamBold" FontSize="16"
                                       TextColor="{DynamicResource WebText}" MaxLines="2" LineBreakMode="TailTruncation">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=OpenCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Text="{Binding MetaText}" Style="{StaticResource LblCardMeta}" />
                                <Label Text="{Binding Note}" FontSize="12.5" TextColor="{DynamicResource WebRoyal2}"
                                       MaxLines="2" LineBreakMode="TailTruncation" />

                                <HorizontalStackLayout Spacing="8" Margin="0,6,0,0">
                                    <Button Text="Đọc tiếp" Style="{StaticResource BtnBrassSm}"
                                            IsVisible="{Binding CanContinue}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=ContinueReadingCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Xem truyện" Style="{StaticResource BtnOutlineSm}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=OpenCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=RemoveText}"
                                            Style="{StaticResource BtnLink}" TextColor="{DynamicResource WebCrimson}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=RemoveCommand}"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Trống (giống ảnh tham khảo: hộp rỗng + lời nhắn) -->
        <VerticalStackLayout Grid.Row="4" IsVisible="{Binding ShowEmpty}" VerticalOptions="Start"
                             Padding="32,70,32,0" Spacing="10">
            <Label Text="📦" FontSize="72" HorizontalTextAlignment="Center" Opacity="0.75" />
            <Label Text="{Binding EmptyTitle}" FontSize="17" FontFamily="BeVietnamSemiBold"
                   TextColor="{DynamicResource WebMuted}" HorizontalTextAlignment="Center" />
            <Label Text="{Binding EmptyHint}" Style="{StaticResource LblMuted}" FontSize="13" HorizontalTextAlignment="Center" />
            <Button Text="Khám phá truyện" Style="{StaticResource BtnBrass}" HorizontalOptions="Center" Padding="28,0"
                    Margin="0,10,0,0" Command="{Binding GoToSearchCommand}" />
        </VerticalStackLayout>

        <!-- ============ Mục "Đã mua" (gói đang dùng + truyện đã mua trọn bộ) ============ -->
        <ScrollView Grid.Row="3" Grid.RowSpan="2" IsVisible="{Binding IsBought}">
            <VerticalStackLayout Padding="16,6,16,32" Spacing="12">

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource WebRoyal}" />
                <Label Text="{Binding ErrorMessage}" TextColor="{DynamicResource WebCrimson}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

                <!-- Chưa đăng nhập -->
                <Border Style="{StaticResource Panel}" IsVisible="{Binding PurchasesNeedLogin}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Đăng nhập để xem truyện và gói đã mua." Style="{StaticResource LblH2}" FontSize="17" />
                        <Button Text="Đăng nhập" Style="{StaticResource BtnBrass}" Command="{Binding GoToLoginCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Gói đang dùng -->
                <Border Style="{StaticResource Panel}" IsVisible="{Binding HasMyPlans}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Gói đang dùng" FontSize="15" FontFamily="BeVietnamBold" TextColor="{DynamicResource WebText}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding MyPlans}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:PlanEntitlement">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding PlanName}" FontSize="14" FontFamily="BeVietnamBold" TextColor="{DynamicResource WebText}" />
                                            <Label Text="{Binding ExpiresText}" Style="{StaticResource LblCardMeta}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding RemainingText}" FontSize="12" FontFamily="BeVietnamBold"
                                               TextColor="{DynamicResource WebSage}" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Truyện đã mua trọn bộ -->
                <Border Style="{StaticResource Panel}" IsVisible="{Binding HasOwnedStories}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Truyện đã mua trọn bộ" FontSize="15" FontFamily="BeVietnamBold" TextColor="{DynamicResource WebText}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding OwnedStories}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:OwnedStory">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=OpenOwnedStoryCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Title}" FontSize="14" FontFamily="BeVietnamBold" TextColor="{DynamicResource WebText}"
                                                   LineBreakMode="TailTruncation" MaxLines="1" />
                                            <Label Text="{Binding PurchasedText}" Style="{StaticResource LblCardMeta}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="›" FontSize="20" TextColor="{DynamicResource WebMuted}" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Chưa mua gì -->
                <VerticalStackLayout IsVisible="{Binding PurchasesEmpty}" Padding="8,24" Spacing="8">
                    <Label Text="Bạn chưa mua gói hay truyện nào." Style="{StaticResource LblH2}" FontSize="18" HorizontalTextAlignment="Center" />
                    <Label Text="Chọn một gói đọc hoặc mua trọn bộ truyện trả phí để đọc không giới hạn." Style="{StaticResource LblMuted}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Button Text="Xem các gói đọc" Style="{StaticResource BtnBrass}" Command="{Binding OpenPlansCommand}" />
                <Button Text="Lịch sử thanh toán" Style="{StaticResource BtnOutlineSm}" HeightRequest="44"
                        Command="{Binding OpenHistoryCommand}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
