<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReadManager.Mobile.ViewModels"
             xmlns:models="clr-namespace:ReadManager.Mobile.Models"
             x:DataType="vm:OrderHistoryViewModel"
             x:Class="ReadManager.Mobile.Views.OrderHistoryPage"
             Title="Lịch sử thanh toán"
             BackgroundColor="{StaticResource WebBg}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IconOverride="ic_back.png" />
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Lọc theo trạng thái -->
        <ScrollView Grid.Row="0" Orientation="Horizontal" BackgroundColor="White" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Filters}" Spacing="8" Padding="16,12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatusFilter">
                        <Button Text="{Binding Label}" Style="{StaticResource TabBtn}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OrderHistoryViewModel}}, Path=SelectStatusCommand}"
                                CommandParameter="{Binding Key}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource WebNavy}" />
                                    <Setter Property="TextColor" Value="White" />
                                    <Setter Property="BorderColor" Value="{StaticResource WebNavy}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Padding="16,8,16,0">
            <Label Text="{Binding CountText}" Style="{StaticResource LblMuted}" />
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource WebCrimson}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource WebRoyal}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}" SelectionMode="None" Margin="16,6,16,0">
            <CollectionView.Footer>
                <VerticalStackLayout Padding="0,4,0,24">
                    <Button Text="Tải thêm" Style="{StaticResource BtnOutlineSm}"
                            Command="{Binding LoadMoreCommand}" IsVisible="{Binding HasMore}" />
                </VerticalStackLayout>
            </CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Order">
                    <Border Style="{StaticResource Panel}" Padding="14" Margin="0,0,0,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OrderHistoryViewModel}}, Path=OpenCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="3" ColumnSpacing="8">
                            <Label Grid.ColumnSpan="2" Text="{Binding TypeLabel}" FontSize="11.5" FontAttributes="Bold"
                                   TextColor="{StaticResource WebMuted}" />
                            <Label Grid.Row="1" Text="{Binding ItemName}" Style="{StaticResource LblCardTitle}" FontSize="15" />
                            <Border Grid.Row="1" Grid.Column="1" Padding="9,3" StrokeThickness="0"
                                    BackgroundColor="{Binding StatusColor}" VerticalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Label Text="{Binding StatusLabel}" FontSize="11" FontAttributes="Bold" TextColor="White" />
                            </Border>
                            <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding ListLine}" Style="{StaticResource LblCardMeta}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Trống / chưa đăng nhập -->
        <VerticalStackLayout Grid.Row="2" IsVisible="{Binding ShowEmpty}" VerticalOptions="Start"
                             Padding="24,60" Spacing="8" InputTransparent="True">
            <Label Text="Chưa có giao dịch nào." Style="{StaticResource LblH2}" FontSize="18" HorizontalTextAlignment="Center" />
            <Label Text="Đơn mua gói hoặc mua truyện của bạn sẽ hiện ở đây." Style="{StaticResource LblMuted}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2" IsVisible="{Binding IsLoggedIn, Converter={StaticResource InvertedBoolConverter}}"
                             VerticalOptions="Start" Padding="24,60" Spacing="12">
            <Label Text="Đăng nhập để xem lịch sử thanh toán." Style="{StaticResource LblH2}" FontSize="18" HorizontalTextAlignment="Center" />
            <Button Text="Đăng nhập" Style="{StaticResource BtnBrass}" Command="{Binding GoToLoginCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
