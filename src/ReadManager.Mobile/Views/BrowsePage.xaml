<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReadManager.Mobile.ViewModels"
             xmlns:models="clr-namespace:ReadManager.Mobile.Models"
             x:DataType="vm:BrowseViewModel"
             x:Class="ReadManager.Mobile.Views.BrowsePage"
             Title="Khám phá"
             BackgroundColor="{StaticResource WebBg}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Ô tìm kiếm (nav-search của web) -->
        <Grid Grid.Row="0" BackgroundColor="White" Padding="16,10">
            <Border Style="{StaticResource FieldBorder}" HeightRequest="40">
                <Entry Style="{StaticResource WebEntry}" HeightRequest="40"
                       Placeholder="Tìm truyện, tác giả..."
                       Text="{Binding SearchText}"
                       ReturnType="Search"
                       ReturnCommand="{Binding SearchCommand}" />
            </Border>
        </Grid>

        <!-- Tiêu đề + bộ lọc (filter-row của web) -->
        <VerticalStackLayout Grid.Row="1" Padding="16,14,16,6" Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{Binding HeadingText}" Style="{StaticResource LblH2}"
                       FontSize="18" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource LblMuted}"
                       VerticalOptions="Center" />
            </Grid>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldBorder}" HeightRequest="42">
                    <Picker ItemsSource="{Binding GenreOptions}" SelectedIndex="{Binding SelectedGenreIndex}"
                            FontSize="13" TextColor="{StaticResource WebText}" BackgroundColor="Transparent" />
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBorder}" HeightRequest="42">
                    <Picker ItemsSource="{Binding AccessOptions}" SelectedIndex="{Binding SelectedAccessIndex}"
                            FontSize="13" TextColor="{StaticResource WebText}" BackgroundColor="Transparent" />
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldBorder}" HeightRequest="42">
                    <Picker ItemsSource="{Binding StatusOptions}" SelectedIndex="{Binding SelectedStatusIndex}"
                            FontSize="13" TextColor="{StaticResource WebText}" BackgroundColor="Transparent" />
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBorder}" HeightRequest="42">
                    <Picker ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SelectedSortIndex}"
                            FontSize="13" TextColor="{StaticResource WebText}" BackgroundColor="Transparent" />
                </Border>
            </Grid>

            <Button Text="Xóa lọc" Style="{StaticResource BtnLink}" HorizontalOptions="End"
                    Command="{Binding ClearFilterCommand}" />

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource WebCrimson}" FontSize="13"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
        </VerticalStackLayout>

        <!-- Lưới thẻ truyện (grid-cards của web) -->
        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Stories}" SelectionMode="None" Margin="16,0">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="14" HorizontalItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.Footer>
                    <BoxView HeightRequest="16" Color="Transparent" />
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:StorySummary">
                        <VerticalStackLayout Spacing="0">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BrowseViewModel}}, Path=GoToDetailCommand}"
                                    CommandParameter="{Binding .}" />
                            </VerticalStackLayout.GestureRecognizers>

                            <Border HeightRequest="220" StrokeThickness="1" Stroke="{StaticResource WebBorder}"
                                    BackgroundColor="{StaticResource WebSurface2}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="4" />
                                </Border.StrokeShape>
                                <Grid>
                                    <Grid.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3B4E63" Offset="0.0" />
                                            <GradientStop Color="#22303F" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Grid.Background>

                                    <Label Text="{Binding Title}" IsVisible="{Binding HasNoCover}"
                                           FontFamily="{StaticResource SerifFont}" FontSize="15" FontAttributes="Bold"
                                           TextColor="White" HorizontalTextAlignment="Center"
                                           VerticalOptions="Center" Margin="10" />
                                    <Image Source="{Binding CoverUrl}" IsVisible="{Binding HasCover}" Aspect="AspectFill" />

                                    <Border HorizontalOptions="Start" VerticalOptions="Start" Margin="7"
                                            Padding="7,3" StrokeThickness="0" BackgroundColor="{Binding AccessColor}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="3" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding AccessLabel}" TextColor="White" FontSize="10" FontAttributes="Bold" />
                                    </Border>

                                    <Border HorizontalOptions="End" VerticalOptions="End" Margin="7"
                                            Padding="6,2" StrokeThickness="0" BackgroundColor="#8C000000">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="3" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding StatusLabel}" TextColor="White" FontSize="9.5" FontAttributes="Bold" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Label Text="{Binding Title}" Style="{StaticResource LblCardTitle}" Margin="0,9,0,0" />
                            <Label Text="{Binding MetaText}" Style="{StaticResource LblCardMeta}" Margin="0,3,0,0" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Không có kết quả (empty-state của web) -->
        <VerticalStackLayout Grid.Row="2" IsVisible="{Binding ShowEmpty}" VerticalOptions="Start"
                             Padding="20,50" Spacing="6" InputTransparent="True">
            <Label Text="Không tìm thấy truyện phù hợp" Style="{StaticResource LblH2}"
                   FontSize="18" HorizontalTextAlignment="Center" />
            <Label Text="Thử đổi từ khóa hoặc bộ lọc khác." Style="{StaticResource LblMuted}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <ActivityIndicator Grid.Row="2" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           Color="{StaticResource WebRoyal}" VerticalOptions="Start" Margin="0,20" />
    </Grid>
</ContentPage>
