<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReadManager.Mobile.ViewModels"
             xmlns:models="clr-namespace:ReadManager.Mobile.Models"
             xmlns:ctl="clr-namespace:ReadManager.Mobile.Views.Controls"
             xmlns:fx="clr-namespace:ReadManager.Mobile.Behaviors"
             x:DataType="vm:ExploreViewModel"
             x:Class="ReadManager.Mobile.Views.BrowsePage"
             Title="Khám phá"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource WebBg}">

    <!-- TAB "KHÁM PHÁ": chuỗi đọc theo từng ngày + số xu (tìm truyện đã chuyển sang nút 🔍 trên header) -->
    <Grid RowDefinitions="Auto,*" RowSpacing="0">
        <ctl:AppHeader x:Name="Header" Grid.Row="0" Title="Khám phá" Subtitle="Chuỗi đọc &amp; xu thưởng" />

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}"
                     RefreshColor="{DynamicResource WebRoyal}">
            <ScrollView>
                <VerticalStackLayout x:Name="Body" Padding="16,16,16,32" Spacing="16">

                    <Label Text="{Binding ErrorMessage}" TextColor="{DynamicResource WebCrimson}"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

                    <!-- ============ KHÁCH ============ -->
                    <Border Style="{StaticResource Panel}" IsVisible="{Binding IsGuest}" fx:Motion.Reveal="True">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="🔥 Chuỗi đọc sách &amp; xu thưởng" Style="{StaticResource LblH2}" />
                            <Label Text="Đăng nhập để giữ chuỗi đọc mỗi ngày: đọc hết 1 chương được +10 xu, từ ngày thứ hai của chuỗi được cộng thêm xu, đổi xu lấy thẻ bảo vệ chuỗi và quà tặng."
                                   Style="{StaticResource LblMuted}" />
                            <Button Text="Đăng nhập" Style="{StaticResource BtnBrass}" Command="{Binding GoToLoginCommand}" />
                            <Button Text="Tạo tài khoản" Style="{StaticResource BtnOutlineSm}" HeightRequest="44"
                                    Command="{Binding GoToRegisterCommand}" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout IsVisible="{Binding IsLoggedIn}" Spacing="16">

                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource WebRoyal}" />

                        <!-- ============ CHUỖI ĐỌC THEO TỪNG NGÀY ============ -->
                        <Border StrokeThickness="0" Padding="18" fx:Motion.Reveal="True">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#17112C" Offset="0.0" />
                                    <GradientStop Color="#2A1B3D" Offset="0.6" />
                                    <GradientStop Color="#4A1730" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Shadow>
                                <Shadow Brush="#17112C" Offset="0,10" Radius="22" Opacity="0.35" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="CHUỖI ĐỌC SÁCH" TextColor="#FDA4AF" FontSize="11" FontFamily="BeVietnamBold"
                                               CharacterSpacing="1.2" />
                                        <HorizontalStackLayout Spacing="8">
                                            <Label x:Name="Flame" Text="🔥" FontSize="40" VerticalOptions="Center"
                                                   TextColor="{Binding Info.FlameColor}" />
                                            <Label Text="{Binding Info.CurrentStreak}" FontSize="44" TextColor="White"
                                                   FontFamily="BeVietnamExtraBold" VerticalOptions="Center" />
                                            <Label Text="ngày" FontSize="16" TextColor="#CBD5E1" VerticalOptions="End" Margin="0,0,0,10" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" HorizontalOptions="End">
                                        <Label Text="Dài nhất" TextColor="#B7C0D6" FontSize="11.5" HorizontalTextAlignment="End" />
                                        <Label TextColor="#FBBF24" FontSize="16" FontFamily="BeVietnamBold" HorizontalTextAlignment="End">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Info.LongestStreak}" />
                                                    <Span Text=" ngày" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                </Grid>

                                <Label Text="{Binding Info.StatusText}" TextColor="#E2E8F0" FontSize="13.5" />

                                <!-- 7 ngày gần nhất (giống trang Chuỗi) -->
                                <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="6" x:Name="DaysRow" />

                                <!-- Tiến độ tới mốc tiếp theo -->
                                <VerticalStackLayout Spacing="6">
                                    <ProgressBar Progress="{Binding MilestoneProgress}" ProgressColor="#FB7185" HeightRequest="6" />
                                    <Label Text="{Binding Info.NextText}" TextColor="#B7C0D6" FontSize="12.5" />
                                </VerticalStackLayout>

                                <Button Text="Xem chi tiết chuỗi  →" BackgroundColor="White" TextColor="#17112C"
                                        FontFamily="BeVietnamBold" FontSize="14.5" CornerRadius="12" HeightRequest="46"
                                        fx:Motion.Press="True" Command="{Binding GoToStreakCommand}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- ============ SỐ XU ============ -->
                        <Border Style="{StaticResource Panel}" fx:Motion.Reveal="True">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <Border WidthRequest="56" HeightRequest="56" StrokeThickness="0" VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="28" />
                                        </Border.StrokeShape>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FDE68A" Offset="0.0" />
                                                <GradientStop Color="#F59E0B" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Label Text="🪙" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                        <Label Text="Số xu của bạn" Style="{StaticResource LblMuted}" />
                                        <Label FontFamily="BeVietnamExtraBold" FontSize="30" TextColor="{DynamicResource WebText}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding CoinsText}" />
                                                    <Span Text=" xu" FontSize="16" TextColor="{DynamicResource WebMuted}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                </Grid>

                                <Border Style="{StaticResource Pill}" HorizontalOptions="Start" Padding="12,5">
                                    <Label Text="{Binding FreezeText}" FontSize="12.5" FontFamily="BeVietnamBold"
                                           TextColor="{DynamicResource WebPillText}" />
                                </Border>

                                <BoxView HeightRequest="1" Color="{DynamicResource WebBorder}" />
                                <Label Text="Cách nhận xu" FontFamily="BeVietnamBold" FontSize="14" TextColor="{DynamicResource WebText}" />
                                <Label Text="📖  Đọc hết một chương: +10 xu (mỗi chương một lần)" Style="{StaticResource LblMuted}" />
                                <Label Text="🔥  Giữ chuỗi từ ngày thứ hai: cộng thêm xu mỗi ngày" Style="{StaticResource LblMuted}" />
                                <Label Text="🧊  Đổi 50 xu lấy 1 thẻ bảo vệ chuỗi (ở trang Chuỗi)" Style="{StaticResource LblMuted}" />

                                <Button Text="Đọc truyện kiếm xu" Style="{StaticResource BtnBrass}" Margin="0,4,0,0"
                                        Command="{Binding GoToSearchCommand}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- ============ LỊCH SỬ XU ============ -->
                        <Border Style="{StaticResource Panel}" Padding="0" IsVisible="{Binding HasHistory}" fx:Motion.Reveal="True">
                            <VerticalStackLayout>
                                <Label Text="Lịch sử xu gần đây" Style="{StaticResource LblH2}" FontSize="17" Padding="18,16,18,6" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding History}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:CoinTransaction">
                                            <Grid Padding="18,10" ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                                                <Label Grid.Column="0" Text="{Binding Icon}" FontSize="20" VerticalOptions="Center" />
                                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                    <Label Text="{Binding Description}" FontSize="13.5" TextColor="{DynamicResource WebText}"
                                                           MaxLines="1" LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding TimeText}" Style="{StaticResource LblCardMeta}" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="2" Text="{Binding AmountText}" TextColor="{Binding AmountColor}"
                                                       FontFamily="BeVietnamBold" FontSize="15" VerticalOptions="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <BoxView HeightRequest="8" Color="Transparent" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
