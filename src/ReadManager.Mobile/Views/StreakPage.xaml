<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReadManager.Mobile.ViewModels"
             xmlns:models="clr-namespace:ReadManager.Mobile.Models"
             xmlns:ctl="clr-namespace:ReadManager.Mobile.Views.Controls"
             xmlns:fx="clr-namespace:ReadManager.Mobile.Behaviors"
             x:DataType="vm:StreakViewModel"
             x:Class="ReadManager.Mobile.Views.StreakPage"
             Title="Chuỗi đọc sách"
             BackgroundColor="{DynamicResource WebBg}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IconOverride="ic_back.png" />
    </Shell.BackButtonBehavior>

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy, Mode=OneWay}">
        <ScrollView>
            <VerticalStackLayout Padding="16,16,16,32" Spacing="14">

                <Label Text="{Binding ErrorMessage}" TextColor="{DynamicResource WebCrimson}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
                <Label Text="{Binding Message}" TextColor="{DynamicResource WebSage}" FontFamily="BeVietnamBold"
                       IsVisible="{Binding Message, Converter={StaticResource StringToBoolConverter}}" />

                <!-- ============ CHƯA ĐĂNG NHẬP ============ -->
                <Border Style="{StaticResource Panel}" IsVisible="{Binding IsGuest}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="🔥 Chuỗi đọc sách" Style="{StaticResource LblH2}" FontSize="22" />
                        <Label Text="Từ ngày thứ hai của chuỗi, mỗi ngày đọc được cộng thêm 5 xu. Đăng nhập, đọc mỗi ngày ít nhất 1 chương để giữ chuỗi và nhận phần thưởng thật: mã giảm giá gói đọc, huy hiệu, danh hiệu, khung avatar..."
                               Style="{StaticResource LblMuted}" />
                        <Button Text="Đăng nhập" Style="{StaticResource BtnBrass}" Command="{Binding GoToLoginCommand}" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout IsVisible="{Binding IsLoggedIn}" Spacing="14">

                    <!-- ============ HERO: CHUỖI HIỆN TẠI ============ -->
                    <Border StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#14101F" Offset="0.0" />
                                <GradientStop Color="#2A1B3D" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Padding="20" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="🔥" FontSize="44" TextColor="{Binding Info.FlameColor}" VerticalOptions="Center" />
                                    <Label Text="{Binding Info.CurrentStreak}" FontSize="46"
                                           TextColor="White" FontFamily="{StaticResource SerifFont}" VerticalOptions="Center" />
                                    <Label Text="ngày" FontSize="16" TextColor="#CBD5E1" VerticalOptions="End" Margin="0,0,0,10" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Info.StatusText}" TextColor="#CBD5E1" FontSize="13.5" />
                                <Label TextColor="{DynamicResource WebAmber}" FontSize="13" FontFamily="BeVietnamBold">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Dài nhất: " />
                                            <Span Text="{Binding Info.LongestStreak}" />
                                            <Span Text=" ngày   ·   🧊 " />
                                            <Span Text="{Binding Info.FreezeCards}" />
                                            <Span Text=" thẻ bảo vệ" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>

                            <!-- Avatar + khung + danh hiệu đang đeo (đổi ở trang Tài khoản) -->
                            <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center" HorizontalOptions="End">
                                <ctl:AvatarView x:Name="AvatarPreview" Diameter="74" Animated="True" HorizontalOptions="Center"
                                                
                                                FrameCode="{Binding Info.SelectedFrame}" Source="{Binding AvatarSource}"
                                                Initial="{Binding UserInitial}" />
                                <ctl:TitleBadge Title="{Binding Info.SelectedTitle}" Small="True" HorizontalOptions="Center" />
                                
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- ============ 7 NGÀY GẦN NHẤT ============ -->
                    <Border Style="{StaticResource Panel}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="7 ngày gần nhất" Style="{StaticResource LblCardTitle}" />
                            <HorizontalStackLayout Spacing="6" HorizontalOptions="Center"
                                  BindableLayout.ItemsSource="{Binding Info.Last7Days}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:StreakDay">
                                        <Border StrokeThickness="1.5" Stroke="{Binding BorderColor}" BackgroundColor="{Binding BgColor}"
                                                Padding="0,8" WidthRequest="40">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Label}" FontSize="11" TextColor="{DynamicResource WebMuted}"
                                                       HorizontalTextAlignment="Center" />
                                                <Label Text="{Binding Mark}" FontSize="18" HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                            <Label Text="{Binding Info.NextText}" Style="{StaticResource LblMuted}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- ============ KHÔI PHỤC CHUỖI ============ -->
                    <Button Text="Đổi 50 xu lấy 1 thẻ bảo vệ chuỗi" Command="{Binding BuyCardCommand}" Style="{StaticResource BtnBrass}" />
                    <Border Style="{StaticResource Panel}" IsVisible="{Binding Info.CanRestore}" BackgroundColor="{DynamicResource WebWarnBg}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="💔 Bạn vừa mất chuỗi" Style="{StaticResource LblCardTitle}" TextColor="{DynamicResource WebCrimson}" />
                            <Label Text="{Binding Info.RestoreText}" Style="{StaticResource LblMuted}" />
                            <Button Text="🔄 Khôi phục chuỗi" Style="{StaticResource BtnBrass}" Command="{Binding RestoreCommand}" />
                        </VerticalStackLayout>
                    </Border>
                    <Label Text="{Binding Info.RestoreText}" Style="{StaticResource LblMuted}" HorizontalTextAlignment="Center"
                           IsVisible="{Binding Info.CanRestore, Converter={StaticResource InvertedBoolConverter}}" />

                    <Button Text="Đọc truyện ngay" Style="{StaticResource BtnBrass}" Command="{Binding GoToBrowseCommand}" />

                    <!-- ============ MỐC THƯỞNG: GIỮ CHUỖI ĐỦ N NGÀY -> NHẬN GÌ ============ -->
                    <VerticalStackLayout Spacing="4" Margin="0,8,0,0">
                        <Label Text="🎁 Mốc thưởng chuỗi" Style="{StaticResource LblH2}" FontSize="19" />
                        <Label Text="Đọc ít nhất 1 chương mỗi ngày. Chuỗi chạm đúng số ngày của mốc là nhận thưởng ngay (mỗi mốc nhận 1 lần). Khung và danh hiệu nhận được sẽ mở khóa ở trang Tài khoản."
                               Style="{StaticResource LblMuted}" FontSize="13" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Info.Milestones}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:StreakMilestone">
                                <Border Style="{StaticResource Panel}" Padding="14" fx:Motion.Reveal="True">
                                    <Grid ColumnDefinitions="64,*" ColumnSpacing="14">
                                        <!-- Số ngày của mốc -->
                                        <Border Grid.Column="0" WidthRequest="64" HeightRequest="64" StrokeThickness="3"
                                                Stroke="{Binding DayColor}" VerticalOptions="Start" BackgroundColor="{DynamicResource WebSurface2}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="32" />
                                            </Border.StrokeShape>
                                            <VerticalStackLayout VerticalOptions="Center" Spacing="-4">
                                                <Label Text="{Binding Days}" FontFamily="BeVietnamExtraBold" FontSize="21"
                                                       TextColor="{Binding DayColor}" HorizontalTextAlignment="Center" />
                                                <Label Text="ngày" FontSize="10.5" TextColor="{DynamicResource WebMuted}" HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                <Label Text="{Binding Name}" FontFamily="BeVietnamExtraBold" FontSize="16"
                                                       TextColor="{DynamicResource WebText}" />
                                                <Label Grid.Column="1" Text="{Binding Mark}" FontSize="16" />
                                            </Grid>
                                            <Label Text="{Binding GoalText}" FontSize="12.5" TextColor="{DynamicResource WebMuted}" />
                                            <ProgressBar Progress="{Binding Progress}" ProgressColor="#F97316" HeightRequest="5" />
                                            <Label Text="{Binding StateText}" FontSize="12.5" FontFamily="BeVietnamBold" TextColor="{Binding StateColor}" />

                                            <!-- Khung + danh hiệu của mốc (xem trước; chưa đạt thì xám + khóa) -->
                                            <FlexLayout Wrap="Wrap" AlignItems="Center" BindableLayout.ItemsSource="{Binding Cosmetics}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="models:StreakRewardItem">
                                                        <Grid Margin="0,4,10,4">
                                                            <HorizontalStackLayout Spacing="6" IsVisible="{Binding IsFrame}">
                                                                <ctl:AvatarView Diameter="40" FrameCode="{Binding Code}" Locked="{Binding Locked}"
                                                                                Initial="{Binding Source={RelativeSource AncestorType={x:Type vm:StreakViewModel}}, Path=UserInitial}" />
                                                                <Label Text="{Binding Name}" FontSize="12.5" FontFamily="BeVietnamSemiBold"
                                                                       TextColor="{DynamicResource WebText}" VerticalOptions="Center" />
                                                            </HorizontalStackLayout>
                                                            <!-- bọc ngoài vì TitleBadge tự bật / tắt IsVisible theo Title -->
                                                            <ContentView IsVisible="{Binding IsTitle}">
                                                                <ctl:TitleBadge Title="{Binding Name}" Locked="{Binding Locked}" />
                                                            </ContentView>
                                                        </Grid>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </FlexLayout>

                                            <!-- Phần thưởng khác: thẻ bảo vệ, mã giảm giá, huy hiệu... -->
                                            <VerticalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding Others}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="models:StreakRewardItem">
                                                        <Label Text="{Binding Display}" FontSize="12.5" TextColor="{DynamicResource WebText}"
                                                               Opacity="{Binding ItemOpacity}" />
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- ============ THÔNG BÁO VỀ CHUỖI ============ -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Thông báo chuỗi" Style="{StaticResource LblH2}" FontSize="19" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Đọc hết" Style="{StaticResource BtnLink}"
                                Command="{Binding MarkAllReadCommand}" IsVisible="{Binding HasNotices}" />
                    </Grid>
                    <Label Text="Chưa có thông báo nào." Style="{StaticResource LblMuted}"
                           IsVisible="{Binding HasNotices, Converter={StaticResource InvertedBoolConverter}}" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Notices}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:StreakNotice">
                                <Border Style="{StaticResource Panel}" Padding="12" Opacity="{Binding ItemOpacity}">
                                    <Grid ColumnDefinitions="30,*" ColumnSpacing="8">
                                        <Label Text="{Binding Icon}" FontSize="22" VerticalOptions="Start" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Message}" FontSize="13.5" TextColor="{DynamicResource WebText}" />
                                            <Label Text="{Binding TimeText}" Style="{StaticResource LblCardMeta}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- ============ BẢNG XẾP HẠNG ============ -->
                    <Label Text="Bảng xếp hạng chuỗi" Style="{StaticResource LblH2}" FontSize="19" IsVisible="{Binding HasBoard}" />
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding HasBoard}" BindableLayout.ItemsSource="{Binding Board}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:StreakRankItem">
                                <Border Style="{StaticResource Panel}" Padding="12">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Line1}" FontSize="14" FontFamily="BeVietnamBold" TextColor="{DynamicResource WebText}" />
                                        <Label Text="{Binding Line2}" Style="{StaticResource LblCardMeta}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
