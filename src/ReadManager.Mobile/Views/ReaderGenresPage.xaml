<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReadManager.Mobile.ViewModels"
             xmlns:models="clr-namespace:ReadManager.Mobile.Models"
             xmlns:fx="clr-namespace:ReadManager.Mobile.Behaviors"
             x:DataType="vm:ReaderGenresViewModel"
             x:Class="ReadManager.Mobile.Views.ReaderGenresPage"
             Title="Sở thích đọc"
             BackgroundColor="{DynamicResource WebBg}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IconOverride="ic_back.png" />
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,16,16,24" Spacing="16">

                <!-- Lời chào -->
                <Border StrokeThickness="0" Padding="20" fx:Motion.Reveal="True">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#17112C" Offset="0.0" />
                            <GradientStop Color="#3B1530" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="✨ Bạn thích đọc thể loại nào?" TextColor="White" FontFamily="BeVietnamExtraBold" FontSize="21" />
                        <Label Text="Chọn một hoặc nhiều thể loại. Mục “Đề xuất cho bạn” ở trang chủ sẽ hiện ngay các truyện hợp gu — đăng nhập lại vẫn giữ nguyên."
                               TextColor="#CBD5E1" FontSize="13.5" LineHeight="1.3" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding ErrorMessage}" TextColor="{DynamicResource WebCrimson}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource WebRoyal}" />

                <Label Text="🌷 Danh mục" Style="{StaticResource SectionTitle}" FontSize="18" />

                <!-- Chip thể loại: bấm để chọn / bỏ chọn -->
                <FlexLayout Wrap="Wrap" JustifyContent="Start" BindableLayout.ItemsSource="{Binding Genres}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ChipItem">
                            <Border Style="{StaticResource Chip}" Margin="0,0,8,10" Padding="16,10" fx:Motion.Reveal="True"
                                    BackgroundColor="{Binding Background}" Stroke="{Binding Stroke}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ReaderGenresViewModel}}, Path=ToggleCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="✓" TextColor="White" FontFamily="BeVietnamBold" FontSize="13.5"
                                           IsVisible="{Binding IsSelected}" VerticalOptions="Center" />
                                    <Label Text="{Binding Name}" Style="{StaticResource ChipText}" TextColor="{Binding Foreground}" />
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Thanh dưới cố định -->
        <Grid Grid.Row="1" BackgroundColor="{DynamicResource WebSurface}" Padding="16,12,16,16"
              RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8" ColumnSpacing="10">
            <BoxView Grid.ColumnSpan="2" HeightRequest="1" Color="{DynamicResource WebBorder}" Margin="-16,-12,-16,0"
                     VerticalOptions="Start" />
            <Label Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding SelectedText}" Style="{StaticResource LblMuted}" Margin="0,4,0,0" />
            <Button Grid.Row="1" Grid.Column="0" Text="Lưu sở thích" Style="{StaticResource BtnBrass}"
                    Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
            <Button Grid.Row="1" Grid.Column="1" Text="Để sau" Style="{StaticResource BtnOutlineSm}" HeightRequest="46"
                    Command="{Binding SkipCommand}" IsVisible="{Binding CanSkip}" />
        </Grid>
    </Grid>
</ContentPage>
