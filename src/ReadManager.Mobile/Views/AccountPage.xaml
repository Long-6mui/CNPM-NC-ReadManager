<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReadManager.Mobile.ViewModels"
             xmlns:ctl="clr-namespace:ReadManager.Mobile.Views.Controls"
             xmlns:fx="clr-namespace:ReadManager.Mobile.Behaviors"
             xmlns:models="clr-namespace:ReadManager.Mobile.Models"
             x:DataType="vm:AccountViewModel"
             x:Class="ReadManager.Mobile.Views.AccountPage"
             Title="Tài khoản"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource WebBg}">

    <!-- TAB "TÀI KHOẢN" (đã bỏ: xu, chuỗi đọc, truyện đang theo dõi, đã thích, xem gần đây).
         Nút Đăng xuất nằm ở cuối trang. -->
    <Grid RowDefinitions="Auto,*" RowSpacing="0">
        <ctl:AppHeader x:Name="Header" Grid.Row="0" Title="Tài khoản" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="Body" Padding="16,18,16,36" Spacing="16">

                <!-- ============ CHƯA ĐĂNG NHẬP ============ -->
                <Border Style="{StaticResource Panel}" IsVisible="{Binding IsGuest}" fx:Motion.Reveal="True">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Tham gia cộng đồng đọc truyện" Style="{StaticResource LblH2}" />
                        <Label Text="Đăng nhập để xem thông tin tài khoản, nhận đề xuất theo sở thích và mua gói đọc." Style="{StaticResource LblMuted}" />
                        <Button Text="Đăng nhập" Style="{StaticResource BtnBrass}"
                                Command="{Binding GoToLoginCommand}" Margin="0,8,0,0" />
                        <Button Text="Đăng ký" Style="{StaticResource BtnOutlineSm}"
                                Command="{Binding GoToRegisterCommand}" HeightRequest="44" />
                    </VerticalStackLayout>
                </Border>

                <!-- ============ ĐÃ ĐĂNG NHẬP ============ -->
                <VerticalStackLayout IsVisible="{Binding IsLoggedIn}" Spacing="16">

                    <!-- Thẻ hồ sơ -->
                    <Border StrokeThickness="0" Padding="18" fx:Motion.Reveal="True">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#17112C" Offset="0.0" />
                                <GradientStop Color="#2A1B3D" Offset="0.6" />
                                <GradientStop Color="#4A1730" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="#17112C" Offset="0,10" Radius="22" Opacity="0.3" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <!-- Ảnh đại diện + khung đang đeo: bấm để đổi ảnh -->
                            <Grid Grid.Column="0" VerticalOptions="Center">
                                <ctl:AvatarView x:Name="ProfileAvatar" Diameter="84" Animated="True"
                                                FrameCode="{Binding SelectedFrame}" Source="{Binding AvatarSource}"
                                                Initial="{Binding Initial}">
                                    <ctl:AvatarView.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ChangeAvatarCommand}" />
                                    </ctl:AvatarView.GestureRecognizers>
                                </ctl:AvatarView>
                                <Border WidthRequest="24" HeightRequest="24" StrokeThickness="2" Stroke="#17112C" InputTransparent="True"
                                        BackgroundColor="#E11D48" HorizontalOptions="End" VerticalOptions="End">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Label Text="📷" FontSize="10" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>

                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding DisplayName}" TextColor="White" FontFamily="BeVietnamExtraBold" FontSize="20"
                                       MaxLines="1" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Email}" TextColor="#CBD5E1" FontSize="13" MaxLines="1" LineBreakMode="TailTruncation" />
                                <ctl:TitleBadge x:Name="ProfileTitle" Title="{Binding SelectedTitle}" Small="True" Margin="0,2,0,0" />
                                <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                                    <Border Padding="10,3" StrokeThickness="0" BackgroundColor="#33FB7185">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding RoleText}" FontSize="11.5" FontFamily="BeVietnamBold" TextColor="#FDA4AF" />
                                    </Border>
                                    <Label TextColor="#94A3B8" FontSize="11.5" VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="ID " />
                                                <Span Text="{Binding UserIdText}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Tài khoản bị hạn chế / khóa (Sprint 3 — dữ liệu từ Backend 2) -->
                    <Border Padding="14" StrokeThickness="0" BackgroundColor="{DynamicResource WebDangerBg}" IsVisible="{Binding HasStatusBanner}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label Text="{Binding StatusBanner}" TextColor="{DynamicResource WebCrimson}" FontSize="13.5" FontFamily="BeVietnamBold" />
                    </Border>

                    <!-- ============ KHUNG AVATAR & DANH HIỆU (đổi trực tiếp) ============ -->
                    <Border Style="{StaticResource Panel}" Padding="0" fx:Motion.Reveal="True">
                        <VerticalStackLayout Padding="0,16,0,14" Spacing="10">
                            <VerticalStackLayout Padding="18,0" Spacing="2">
                                <Label Text="🎨 Khung avatar &amp; danh hiệu" Style="{StaticResource LblH2}" FontSize="17" />
                                <Label Text="{Binding CosmeticSummary}" Style="{StaticResource LblCardMeta}" />
                                <Label Text="Bấm để đeo, bấm lần nữa để bỏ. Đồ có 🔒 mở khi giữ chuỗi đọc đủ số ngày."
                                       Style="{StaticResource LblCardMeta}" />
                            </VerticalStackLayout>

                            <Label Text="Khung avatar" FontFamily="BeVietnamBold" FontSize="14" TextColor="{DynamicResource WebText}" Padding="18,4,18,0" />
                            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                <HorizontalStackLayout Padding="12,0" Spacing="4" BindableLayout.ItemsSource="{Binding Frames}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:CosmeticItem">
                                            <Border WidthRequest="92" Padding="4,10" StrokeThickness="2" Stroke="{Binding SelectStroke}"
                                                    BackgroundColor="{Binding SelectBackground}" fx:Motion.Press="True">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="16" />
                                                </Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AccountViewModel}}, Path=PickCosmeticCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <VerticalStackLayout Spacing="6">
                                                    <ctl:AvatarView Diameter="60" HorizontalOptions="Center" FrameCode="{Binding Code}"
                                                                    Locked="{Binding Locked}" InputTransparent="True"
                                                                    Source="{Binding Source={RelativeSource AncestorType={x:Type vm:AccountViewModel}}, Path=AvatarSource}"
                                                                    Initial="{Binding Source={RelativeSource AncestorType={x:Type vm:AccountViewModel}}, Path=Initial}" />
                                                    <Label Text="{Binding Name}" FontSize="12" FontFamily="BeVietnamSemiBold" HorizontalTextAlignment="Center"
                                                           TextColor="{DynamicResource WebText}" MaxLines="1" LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding StatusText}" FontSize="10.5" HorizontalTextAlignment="Center"
                                                           TextColor="{Binding StatusColor}" MaxLines="1" LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </ScrollView>

                            <Label Text="Danh hiệu" FontFamily="BeVietnamBold" FontSize="14" TextColor="{DynamicResource WebText}" Padding="18,6,18,0" />
                            <FlexLayout Wrap="Wrap" Padding="14,0" BindableLayout.ItemsSource="{Binding Titles}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:CosmeticItem">
                                        <Border Margin="0,0,6,8" Padding="6" StrokeThickness="2" Stroke="{Binding SelectStroke}"
                                                BackgroundColor="{Binding SelectBackground}" fx:Motion.Press="True">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="16" />
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AccountViewModel}}, Path=PickCosmeticCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout Spacing="4">
                                                <ctl:TitleBadge Title="{Binding Name}" Locked="{Binding Locked}" InputTransparent="True" />
                                                <Label Text="{Binding StatusText}" FontSize="10.5" TextColor="{Binding StatusColor}"
                                                       HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Menu -->
                    <Border Style="{StaticResource Panel}" Padding="0" fx:Motion.Reveal="True">
                        <VerticalStackLayout>
                            <Grid Style="{StaticResource MenuRow}" ColumnDefinitions="Auto,*,Auto,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToNotificationsCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="🔔" FontSize="19" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Thông báo" FontSize="15" FontFamily="BeVietnamSemiBold"
                                       TextColor="{DynamicResource WebText}" VerticalOptions="Center" />
                                <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalOptions="Center"
                                        IsVisible="{Binding NotificationsText, Converter={StaticResource StringToBoolConverter}}">
                                    <Label Text="{Binding NotificationsText}" FontSize="11.5" FontFamily="BeVietnamBold"
                                           TextColor="{DynamicResource WebPillText}" />
                                </Border>
                                <Label Grid.Column="3" Text="›" FontSize="22" TextColor="{DynamicResource WebMuted}" VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{DynamicResource WebBorder}" Margin="52,0,0,0" />

                            <Grid Style="{StaticResource MenuRow}" ColumnDefinitions="Auto,*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding EditGenresCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="🌷" FontSize="19" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Sở thích đọc" FontSize="15" FontFamily="BeVietnamSemiBold" TextColor="{DynamicResource WebText}" />
                                    <Label Text="Thể loại dùng cho mục Đề xuất cho bạn" Style="{StaticResource LblCardMeta}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="22" TextColor="{DynamicResource WebMuted}" VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{DynamicResource WebBorder}" Margin="52,0,0,0" />

                            <Grid Style="{StaticResource MenuRow}" ColumnDefinitions="Auto,*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenWalletCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="🎟" FontSize="19" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Kho mã giảm giá" FontSize="15" FontFamily="BeVietnamSemiBold" TextColor="{DynamicResource WebText}" />
                                    <Label Text="Voucher mua truyện &amp; mã giảm gói đọc từ chuỗi" Style="{StaticResource LblCardMeta}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="22" TextColor="{DynamicResource WebMuted}" VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{DynamicResource WebBorder}" Margin="52,0,0,0" />

                            <Grid Style="{StaticResource MenuRow}" ColumnDefinitions="Auto,*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToPlansCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="💎" FontSize="19" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Gói đọc theo tháng" FontSize="15" FontFamily="BeVietnamSemiBold" TextColor="{DynamicResource WebText}" />
                                    <Label Text="Gia hạn sớm hoặc muộn đều được cộng dồn" Style="{StaticResource LblCardMeta}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="22" TextColor="{DynamicResource WebMuted}" VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{DynamicResource WebBorder}" Margin="52,0,0,0" />

                            <Grid Style="{StaticResource MenuRow}" ColumnDefinitions="Auto,*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToPaidStoriesCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="🛒" FontSize="19" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Mua riêng từng truyện" FontSize="15" FontFamily="BeVietnamSemiBold" TextColor="{DynamicResource WebText}" />
                                    <Label Text="Tìm truyện trả phí để mua trọn bộ" Style="{StaticResource LblCardMeta}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="22" TextColor="{DynamicResource WebMuted}" VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{DynamicResource WebBorder}" Margin="52,0,0,0" />

                            <Grid Style="{StaticResource MenuRow}" ColumnDefinitions="Auto,*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToOrderHistoryCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="🧾" FontSize="19" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Lịch sử thanh toán" FontSize="15" FontFamily="BeVietnamSemiBold"
                                       TextColor="{DynamicResource WebText}" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="›" FontSize="22" TextColor="{DynamicResource WebMuted}" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Thông tin cá nhân -->
                    <Border Style="{StaticResource Panel}" fx:Motion.Reveal="True">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Thông tin cá nhân" Style="{StaticResource LblH2}" FontSize="17" />
                            <Border Style="{StaticResource FieldBorder}" BackgroundColor="{DynamicResource WebSurface2}">
                                <Entry Style="{StaticResource WebEntry}" Text="{Binding DisplayName}" IsReadOnly="True" />
                            </Border>
                            <Border Style="{StaticResource FieldBorder}" BackgroundColor="{DynamicResource WebSurface2}">
                                <Entry Style="{StaticResource WebEntry}" Text="{Binding Email}" IsReadOnly="True" />
                            </Border>
                            <Label Style="{StaticResource LblMuted}" FontSize="12"
                                   Text="Đổi tên và email cần API cập nhật hồ sơ. Khi đổi email, hệ thống sẽ gửi thư xác nhận đến địa chỉ mới. Tính năng này đang chờ Backend 2." />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Đổi mật khẩu -->
                    <Border Style="{StaticResource Panel}" fx:Motion.Reveal="True">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Đổi mật khẩu" Style="{StaticResource LblH2}" FontSize="17" />
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Style="{StaticResource WebEntry}" Text="{Binding CurrentPassword}" IsPassword="True"
                                       Placeholder="Mật khẩu hiện tại" />
                            </Border>
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Style="{StaticResource WebEntry}" Text="{Binding NewPassword}" IsPassword="True"
                                       Placeholder="Mật khẩu mới (tối thiểu 6 ký tự)" />
                            </Border>
                            <Border Style="{StaticResource FieldBorder}">
                                <Entry Style="{StaticResource WebEntry}" Text="{Binding ConfirmPassword}" IsPassword="True"
                                       Placeholder="Xác nhận mật khẩu mới" />
                            </Border>
                            <Label Text="{Binding PasswordMessage}" TextColor="{DynamicResource WebRoyal2}" FontSize="13"
                                   IsVisible="{Binding PasswordMessage, Converter={StaticResource StringToBoolConverter}}" />
                            <Button Text="Đổi mật khẩu" Style="{StaticResource BtnBrass}" Command="{Binding ChangePasswordCommand}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Cài đặt kết nối (Sprint 4: demo trên điện thoại thật) -->
                <Button Text="⚙ Địa chỉ máy chủ" Style="{StaticResource BtnLink}"
                        Command="{Binding OpenServerSettingsCommand}" HorizontalOptions="Center" />

                <!-- ============ ĐĂNG XUẤT (cuối trang) ============ -->
                <Button Text="⎋  Đăng xuất" Style="{StaticResource BtnDanger}" IsVisible="{Binding IsLoggedIn}"
                        Command="{Binding LogoutCommand}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
