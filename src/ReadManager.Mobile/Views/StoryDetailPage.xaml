<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReadManager.Mobile.ViewModels"
             x:DataType="vm:StoryDetailViewModel"
             x:Class="ReadManager.Mobile.Views.StoryDetailPage"
             Title="Chi tiết truyện"
             BackgroundColor="{DynamicResource WebBg}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IconOverride="ic_back.png" />
    </Shell.BackButtonBehavior>

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{DynamicResource WebRoyal}" Margin="0,24" />

            <Label Text="{Binding ErrorMessage}" TextColor="{DynamicResource WebCrimson}" Padding="16,16"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <VerticalStackLayout IsVisible="{Binding Story, Converter={StaticResource StringToBoolConverter}}" Spacing="0">

                <!-- Hero truyện (story-hero) -->
                <Grid Padding="20,24,20,28" ColumnDefinitions="120,*" ColumnSpacing="16" RowDefinitions="Auto,Auto">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#14101F" Offset="0.0" />
                            <GradientStop Color="#0A0D17" Offset="1.0" />
                        </LinearGradientBrush>
                    </Grid.Background>

                    <!-- Bìa -->
                    <Border Grid.Column="0" Grid.Row="0" HeightRequest="180" StrokeThickness="1"
                            Stroke="#29FFFFFF" VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,12" Radius="20" Opacity="0.55" />
                        </Border.Shadow>
                        <Grid>
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3F3A55" Offset="0.0" />
                                    <GradientStop Color="#1E1B2E" Offset="1.0" />
                                </LinearGradientBrush>
                            </Grid.Background>
                            <Label Text="{Binding Story.Title}" IsVisible="{Binding Story.HasNoCover}"
                                   FontFamily="{StaticResource SerifFont}" FontSize="14"
                                   TextColor="White" HorizontalTextAlignment="Center"
                                   VerticalOptions="Center" Margin="8" />
                            <Image Source="{Binding Story.CoverUrl}" IsVisible="{Binding Story.HasCover}" Aspect="AspectFill" />
                            <Border HorizontalOptions="Start" VerticalOptions="Start" Margin="7"
                                    Padding="7,3" StrokeThickness="0" BackgroundColor="{Binding Story.AccessColor}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label Text="{Binding Story.AccessLabel}" TextColor="White" FontSize="10" FontFamily="BeVietnamBold" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Tiêu đề + tác giả -->
                    <VerticalStackLayout Grid.Column="1" Grid.Row="0" Spacing="6">
                        <Label Text="{Binding Story.Title}" TextColor="White"
                               FontFamily="{StaticResource SerifFont}" FontSize="24" />
                        <Label Text="{Binding Story.AuthorText}" TextColor="#FB7185" FontSize="14" FontFamily="BeVietnamBold" />
                        <FlexLayout Wrap="Wrap" Margin="0,6,0,0"
                                    BindableLayout.ItemsSource="{Binding Story.Tags}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Padding="10,4" Margin="0,0,7,7" StrokeThickness="1"
                                            Stroke="#29FFFFFF" BackgroundColor="#17FFFFFF">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding .}" TextColor="#EEEBE4" FontSize="11.5" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <!-- Mô tả + nút + thống kê (chiếm cả hàng dưới) -->
                    <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="14" Margin="0,16,0,0">
                        <Label Text="{Binding Story.Synopsis}" TextColor="#CBD5E1" FontSize="14" />

                        <!-- Nút hành động: xem chương + yêu thích (Tủ sách) -->
                        <HorizontalStackLayout Spacing="10">
                            <Button Text="Xem chương" Style="{StaticResource BtnBrass}"
                                    Command="{Binding OpenChaptersCommand}" />
                            <Button Text="{Binding FavoriteText}" Style="{StaticResource BtnLight}"
                                    Command="{Binding ToggleFavoriteCommand}" />
                        </HorizontalStackLayout>

                        <!-- Theo dõi truyện (Sprint 3): nhận thông báo khi có chương mới -->
                        <HorizontalStackLayout Spacing="10">
                            <Button Text="{Binding FollowText}" Style="{StaticResource BtnLight}"
                                    Command="{Binding ToggleFollowCommand}" />
                            <Label Text="{Binding FollowerText}" TextColor="#A1A1AA" FontSize="12.5" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Mua trọn bộ (PB21) / đã sở hữu -->
                        <Button Text="{Binding BuyText}" Style="{StaticResource BtnAmber}"
                                Command="{Binding BuyCommand}" IsVisible="{Binding ShowBuy}" />
                        <Label Text="✔ Bạn đã sở hữu truyện này" TextColor="#7DDBA3" FontFamily="BeVietnamBold" FontSize="14"
                               IsVisible="{Binding ShowOwned}" />

                        <Border BackgroundColor="#14FFFFFF" Stroke="#1FFFFFFF" StrokeThickness="1" Padding="10,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,6,0,0">
                            <VerticalStackLayout Spacing="2" Grid.Column="0" HorizontalOptions="Center">
                                <Label Text="{Binding Story.PublishedChapterCount}" TextColor="White"
                                       FontFamily="{StaticResource SerifFont}" FontSize="19" />
                                <Label Text="Chương" TextColor="#A1A1AA" FontSize="11.5" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2" Grid.Column="1" HorizontalOptions="Center">
                                <Label Text="{Binding Story.PriceText}" TextColor="White"
                                       FontFamily="{StaticResource SerifFont}" FontSize="19" />
                                <Label Text="{Binding Story.PriceCaption}" TextColor="#A1A1AA" FontSize="11.5" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2" Grid.Column="2" HorizontalOptions="Center">
                                <Label Text="{Binding Story.FreeChaptersText}" TextColor="White"
                                       FontFamily="{StaticResource SerifFont}" FontSize="19" />
                                <Label Text="Chương đọc miễn phí" TextColor="#A1A1AA" FontSize="11.5" />
                            </VerticalStackLayout>
                        </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- Danh sách chương -->
                <VerticalStackLayout Padding="16,24,16,0" Spacing="12">
                    <Label Text="Danh sách chương" Style="{StaticResource LblH2}" FontSize="18" />
                    <Button Text="Xem danh sách chương" Style="{StaticResource BtnBrass}" Command="{Binding OpenChaptersCommand}" />
                    <Button Text="💬 Bình luận" Style="{StaticResource BtnOutlineSm}" HeightRequest="44"
                            Command="{Binding OpenCommentsCommand}" />
                    <Button Text="⚑ Báo cáo truyện này" Style="{StaticResource BtnLink}" HorizontalOptions="Start"
                            TextColor="{DynamicResource WebCrimson}" Command="{Binding ReportStoryCommand}" />
                </VerticalStackLayout>

                <!-- Giới thiệu (panel bên phải của web) -->
                <VerticalStackLayout Padding="16,16,16,32">
                    <Border Style="{StaticResource Panel}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Giới thiệu" FontSize="15" FontFamily="BeVietnamBold" TextColor="{DynamicResource WebText}" />
                            <Label Text="{Binding Story.Synopsis}" FontSize="13.5" TextColor="{DynamicResource WebMuted}" />
                            <BoxView HeightRequest="1" Color="{DynamicResource WebBorder}" Margin="0,4" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Tác giả" FontSize="13" TextColor="{DynamicResource WebMuted}" />
                                <Label Grid.Column="1" Text="{Binding Story.AuthorText}" FontSize="13" FontFamily="BeVietnamBold" TextColor="{DynamicResource WebText}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Tình trạng" FontSize="13" TextColor="{DynamicResource WebMuted}" />
                                <Label Grid.Column="1" Text="{Binding Story.StatusLabel}" FontSize="13" FontFamily="BeVietnamBold" TextColor="{DynamicResource WebText}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Cập nhật" FontSize="13" TextColor="{DynamicResource WebMuted}" />
                                <Label Grid.Column="1" Text="{Binding Story.UpdatedText}" FontSize="13" FontFamily="BeVietnamBold" TextColor="{DynamicResource WebText}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
