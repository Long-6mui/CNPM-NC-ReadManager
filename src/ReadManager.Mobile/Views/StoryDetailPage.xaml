<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReadManager.Mobile.ViewModels"
             x:DataType="vm:StoryDetailViewModel"
             x:Class="ReadManager.Mobile.Views.StoryDetailPage"
             Title="Chi tiết truyện"
             BackgroundColor="{StaticResource WebBg}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{StaticResource WebRoyal}" Margin="0,24" />

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource WebCrimson}" Padding="16,16"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />

            <VerticalStackLayout IsVisible="{Binding Story, Converter={StaticResource StringToBoolConverter}}" Spacing="0">

                <!-- Hero truyện (story-hero) -->
                <Grid Padding="20,24,20,28" ColumnDefinitions="120,*" ColumnSpacing="16" RowDefinitions="Auto,Auto">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0B1F4B" Offset="0.0" />
                            <GradientStop Color="#07142F" Offset="1.0" />
                        </LinearGradientBrush>
                    </Grid.Background>

                    <!-- Bìa -->
                    <Border Grid.Column="0" Grid.Row="0" HeightRequest="180" StrokeThickness="1"
                            Stroke="#29FFFFFF" VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="4" />
                        </Border.StrokeShape>
                        <Grid>
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3B4E63" Offset="0.0" />
                                    <GradientStop Color="#22303F" Offset="1.0" />
                                </LinearGradientBrush>
                            </Grid.Background>
                            <Label Text="{Binding Story.Title}" IsVisible="{Binding Story.HasNoCover}"
                                   FontFamily="{StaticResource SerifFont}" FontSize="14" FontAttributes="Bold"
                                   TextColor="White" HorizontalTextAlignment="Center"
                                   VerticalOptions="Center" Margin="8" />
                            <Image Source="{Binding Story.CoverUrl}" IsVisible="{Binding Story.HasCover}" Aspect="AspectFill" />
                            <Border HorizontalOptions="Start" VerticalOptions="Start" Margin="7"
                                    Padding="7,3" StrokeThickness="0" BackgroundColor="{Binding Story.AccessColor}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="3" />
                                </Border.StrokeShape>
                                <Label Text="{Binding Story.AccessLabel}" TextColor="White" FontSize="10" FontAttributes="Bold" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Tiêu đề + tác giả -->
                    <VerticalStackLayout Grid.Column="1" Grid.Row="0" Spacing="6">
                        <Label Text="{Binding Story.Title}" TextColor="White"
                               FontFamily="{StaticResource SerifFont}" FontSize="24" FontAttributes="Bold" />
                        <Label Text="{Binding Story.AuthorText}" TextColor="#4F83FF" FontSize="14" FontAttributes="Bold" />
                        <FlexLayout Wrap="Wrap" Margin="0,6,0,0"
                                    BindableLayout.ItemsSource="{Binding Story.Tags}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Padding="10,4" Margin="0,0,7,7" StrokeThickness="1"
                                            Stroke="#29FFFFFF" BackgroundColor="#17FFFFFF">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding .}" TextColor="#E4EAF8" FontSize="11.5" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <!-- Mô tả + nút + thống kê (chiếm cả hàng dưới) -->
                    <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="14" Margin="0,16,0,0">
                        <Label Text="{Binding Story.Synopsis}" TextColor="#C3D2F5" FontSize="14" />

                        <!-- Web: "Chưa có chương" khi chưa có API chương -->
                        <Border HorizontalOptions="Start" Padding="16,10" StrokeThickness="1"
                                Stroke="#8CFFFFFF" Opacity="0.6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Label Text="Chưa có chương" TextColor="White" FontSize="14" FontAttributes="Bold" />
                        </Border>

                        <HorizontalStackLayout Spacing="26" Margin="0,6,0,0">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Story.PublishedChapterCount}" TextColor="White"
                                       FontFamily="{StaticResource SerifFont}" FontSize="19" FontAttributes="Bold" />
                                <Label Text="Chương" TextColor="#9DB0D6" FontSize="11.5" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Story.PriceText}" TextColor="White"
                                       FontFamily="{StaticResource SerifFont}" FontSize="19" FontAttributes="Bold" />
                                <Label Text="{Binding Story.PriceCaption}" TextColor="#9DB0D6" FontSize="11.5" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Story.FreeChaptersText}" TextColor="White"
                                       FontFamily="{StaticResource SerifFont}" FontSize="19" FontAttributes="Bold" />
                                <Label Text="Chương đọc miễn phí" TextColor="#9DB0D6" FontSize="11.5" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>

                <!-- Danh sách chương -->
                <VerticalStackLayout Padding="16,24,16,0" Spacing="12">
                    <Label Text="Danh sách chương" Style="{StaticResource LblH2}" FontSize="18" />
                    <Border Style="{StaticResource Panel}" Padding="20,36">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Chưa có chương nào" Style="{StaticResource LblH2}"
                                   FontSize="18" HorizontalTextAlignment="Center" />
                            <Label Text="Quản trị viên sẽ sớm đăng nội dung đầu tiên."
                                   Style="{StaticResource LblMuted}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Giới thiệu (panel bên phải của web) -->
                <VerticalStackLayout Padding="16,16,16,32">
                    <Border Style="{StaticResource Panel}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Giới thiệu" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource WebText}" />
                            <Label Text="{Binding Story.Synopsis}" FontSize="13.5" TextColor="{StaticResource WebMuted}" />
                            <BoxView HeightRequest="1" Color="{StaticResource WebBorder}" Margin="0,4" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Tác giả" FontSize="13" TextColor="{StaticResource WebMuted}" />
                                <Label Grid.Column="1" Text="{Binding Story.AuthorText}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource WebText}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Tình trạng" FontSize="13" TextColor="{StaticResource WebMuted}" />
                                <Label Grid.Column="1" Text="{Binding Story.StatusLabel}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource WebText}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Cập nhật" FontSize="13" TextColor="{StaticResource WebMuted}" />
                                <Label Grid.Column="1" Text="{Binding Story.UpdatedText}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource WebText}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
