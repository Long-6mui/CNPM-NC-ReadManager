<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!-- Theme lấy từ web (wwwroot/css/marvel-3d-theme.css, chế độ sáng): nền giấy ấm, chữ than, nhấn đỏ hồng #E11D48,
     điểm vàng #EAB308, phông Be Vietnam Pro. Giữ nguyên tên khóa cũ (WebRoyal, WebNavy...) để các trang không phải sửa. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Bảng màu -->
    <Color x:Key="WebNavy">#18181B</Color>        <!-- mực đậm: avatar, chữ nhấn -->
    <Color x:Key="WebRoyal">#E11D48</Color>       <!-- màu nhấn chính (nút, liên kết, tab đang chọn) -->
    <Color x:Key="WebRoyal2">#BE123C</Color>      <!-- nhấn đậm: liên kết, nhấn khi bấm -->
    <Color x:Key="WebAmber">#EAB308</Color>       <!-- vàng điểm nhấn -->
    <Color x:Key="WebBg">#F6F5F2</Color>          <!-- nền trang (giấy ấm) -->
    <Color x:Key="WebSurface">#FFFFFF</Color>     <!-- nền thẻ -->
    <Color x:Key="WebSurface2">#EFEDE7</Color>
    <Color x:Key="WebText">#18181B</Color>
    <Color x:Key="WebMuted">#52525B</Color>
    <Color x:Key="WebBorder">#E4E1D9</Color>
    <Color x:Key="WebSage">#12A150</Color>
    <Color x:Key="WebCrimson">#DC2626</Color>     <!-- lỗi / giá -->
    <Color x:Key="WebPill">#FFE4E9</Color>        <!-- nền nhãn đỏ nhạt -->
    <Color x:Key="WebPillText">#BE123C</Color>
    <Color x:Key="WebInk2">#27272A</Color>

    <!-- Phông: Be Vietnam Pro (đậm cho tiêu đề thay cho phông có chân cũ) -->
    <x:String x:Key="SerifFont">BeVietnamBold</x:String>
    <x:String x:Key="FontRegular">BeVietnamRegular</x:String>
    <x:String x:Key="FontMedium">BeVietnamMedium</x:String>
    <x:String x:Key="FontSemiBold">BeVietnamSemiBold</x:String>
    <x:String x:Key="FontBold">BeVietnamBold</x:String>
    <x:String x:Key="FontExtraBold">BeVietnamExtraBold</x:String>

    <!-- Nút -->
    <Style x:Key="BtnBrass" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource WebRoyal}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontFamily" Value="BeVietnamSemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="Shadow">
            <Shadow Brush="#E11D48" Offset="0,6" Radius="14" Opacity="0.28" />
        </Setter>
    </Style>
    <Style x:Key="BtnBrassSm" TargetType="Button" BasedOn="{StaticResource BtnBrass}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HeightRequest" Value="38" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style x:Key="BtnOutlineSm" TargetType="Button">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="TextColor" Value="{StaticResource WebText}" />
        <Setter Property="BorderColor" Value="{StaticResource WebBorder}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="BeVietnamSemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="HeightRequest" Value="40" />
    </Style>
    <Style x:Key="BtnLight" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#14FFFFFF" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="BorderColor" Value="#55FFFFFF" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="BeVietnamSemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="HeightRequest" Value="46" />
    </Style>
    <Style x:Key="BtnAmber" TargetType="Button" BasedOn="{StaticResource BtnBrass}">
        <Setter Property="BackgroundColor" Value="{StaticResource WebAmber}" />
        <Setter Property="TextColor" Value="#241A08" />
        <Setter Property="Shadow">
            <Shadow Brush="#EAB308" Offset="0,6" Radius="14" Opacity="0.30" />
        </Setter>
    </Style>
    <Style x:Key="BtnLink" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource WebRoyal2}" />
        <Setter Property="FontFamily" Value="BeVietnamSemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="HeightRequest" Value="36" />
    </Style>
    <Style x:Key="TabBtn" TargetType="Button">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="TextColor" Value="{StaticResource WebMuted}" />
        <Setter Property="BorderColor" Value="{StaticResource WebBorder}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="BeVietnamSemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="HeightRequest" Value="36" />
    </Style>

    <!-- Chữ -->
    <Style x:Key="LblH2" TargetType="Label">
        <Setter Property="FontFamily" Value="BeVietnamBold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{StaticResource WebText}" />
    </Style>
    <Style x:Key="LblMuted" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="1.35" />
        <Setter Property="TextColor" Value="{StaticResource WebMuted}" />
    </Style>
    <Style x:Key="LblFieldName" TargetType="Label">
        <Setter Property="FontFamily" Value="BeVietnamSemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource WebText}" />
    </Style>
    <Style x:Key="LblCardTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="BeVietnamSemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource WebText}" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>
    <Style x:Key="LblCardMeta" TargetType="Label">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="TextColor" Value="{StaticResource WebMuted}" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>
    <!-- Dòng nhãn nhỏ viết hoa phía trên tiêu đề mục (eyebrow) -->
    <Style x:Key="LblEyebrow" TargetType="Label">
        <Setter Property="FontFamily" Value="BeVietnamBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="1.2" />
        <Setter Property="TextColor" Value="{StaticResource WebRoyal}" />
    </Style>

    <!-- Khung / ô nhập -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="Stroke" Value="{StaticResource WebBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="16" />
        </Setter>
        <Setter Property="Shadow">
            <Shadow Brush="#18181B" Offset="0,6" Radius="18" Opacity="0.06" />
        </Setter>
    </Style>
    <Style x:Key="FieldBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#F4F4F5" />
        <Setter Property="Stroke" Value="{StaticResource WebBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="10" />
        </Setter>
    </Style>
    <!-- Nhãn nhỏ dạng viên thuốc (pill) -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource WebPill}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="12" />
        </Setter>
    </Style>
    <Style x:Key="WebEntry" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource WebText}" />
        <Setter Property="PlaceholderColor" Value="#A1A1AA" />
        <Setter Property="FontFamily" Value="BeVietnamRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="46" />
    </Style>
</ResourceDictionary>
